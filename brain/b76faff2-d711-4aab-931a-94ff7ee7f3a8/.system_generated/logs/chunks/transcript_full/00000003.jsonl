ter-heading\">Ordering</h4>\n          <ul class=\"footer-links\">\n            <li><a href=\"#menu\">Full Food Menu</a></li>\n            <li><a href=\"#bestsellers\">Our Bestsellers</a></li>\n            <li><a href=\"order-tracking.html\">Track Existing Order</a></li>\n            <li><a href=\"#\" id=\"footerCartLink\">Open Shopping Cart</a></li>\n          </ul>\n        </div>\n\n        <div>\n          <h4 class=\"footer-heading\">Navigation</h4>\n          <ul class=\"footer-links\">\n            <li><a href=\"#hero\">Home</a></li>\n            <li><a href=\"#about\">Our Story</a></li>\n            <li><a href=\"#gallery\">Photo Gallery</a></li>\n            <li><a href=\"#location\">Hours &amp; Location</a></li>\n            <li><a href=\"driver.html\">Driver Portal</a></li>\n            <li><a href=\"admin.html\">Café Admin Portal</a></li>\n          </ul>\n        </div>\n\n        <div>\n          <h4 class=\"footer-heading\">Visit Us</h4>\n          <address class=\"footer-address\">\n            <p>[Sample Address], Haldia, WB – 721657</p>\n            <p>Mon–Fri: 8:00 AM – 9:00 PM</p>\n            <p>Sat–Sun: 8:00 AM – 10:00 PM</p>\n            <p style=\"color:var(--golden-yellow); font-weight:700; margin-top:0.5rem;\">Delivery Radius: 10 KM</p>\n          </address>\n        </div>\n      </div>\n\n      <div class=\"footer-bottom\">\n        <p>&copy; 2026 Brew &amp; Bloom Café, Haldia. All rights reserved.</p>\n        <p class=\"footer-disclaimer\">This is a demonstration food ordering platform. All menu items, pricing, delivery simulations, addresses and credentials are demo content for illustration and operational readiness.</p>\n      </div>\n    </div>\n  </footer>\n\n  <!-- ═══════════════════ CART DRAWER ═══════════════════ -->\n  <div class=\"cart-drawer-backdrop\" id=\"cartDrawerBackdrop\" aria-hidden=\"true\"></div>\n  <aside class=\"cart-drawer\" id=\"cartDrawer\" aria-label=\"Shopping Cart Drawer\" role=\"dialog\" aria-modal=\"true\">\n    <div class=\"cart-drawer-header\">\n      <h3 class=\"cart-drawer-title\">\n        <span>🛒</span>\n        <span>Your Order</span>\n      </h3>\n      <button class=\"cart-close-btn\" id=\"closeCartBtn\" aria-label=\"Close Shopping Cart\">✕</button>\n    </div>\n\n    <div class=\"cart-drawer-body\" id=\"cartDrawerItems\">\n      <!-- Items dynamically populated by script.js -->\n    </div>\n\n    <div class=\"cart-drawer-footer\" id=\"cartDrawerFooter\">\n      <div class=\"cart-summary-line\">\n        <span>Items Subtotal</span>\n        <span id=\"cartDrawerSubtotal\">₹0</span>\n      </div>\n      <div class=\"cart-summary-line\">\n        <span>GST Tax (5%)</span>\n        <span id=\"cartDrawerTax\">₹0</span>\n      </div>\n      <div class=\"cart-summary-line\">\n        <span>Est. Delivery</span>\n        <span id=\"cartDrawerDelivery\">₹30</span>\n      </div>\n      <div class=\"cart-total-line\">\n        <span>Total Payable</span>\n        <span id=\"cartDrawerTotal\">₹0</span>\n      </div>\n\n      <button class=\"btn btn-primary checkout-btn\" id=\"proceedCheckoutBtn\">\n        Proceed to Checkout →\n      </button>\n    </div>\n  </aside>\n\n  <!-- ═══════════════════ CHECKOUT MODAL ═══════════════════ -->\n  <div class=\"checkout-modal-backdrop\" id=\"checkoutModalBackdrop\" aria-hidden=\"true\">\n    <div class=\"checkout-modal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"checkoutModalTitle\">\n      <div class=\"checkout-modal-header\">\n        <h3 class=\"checkout-modal-title\" id=\"checkoutModalTitle\">Checkout &amp; Delivery Details</h3>\n        <button class=\"cart-close-btn\" id=\"closeCheckoutBtn\" aria-label=\"Close Checkout\">✕</button>\n      </div>\n\n      <div class=\"checkout-modal-body\">\n        <!-- Delivery Mode Switcher -->\n        <div class=\"delivery-mode-switcher\" role=\"radiogroup\" aria-label=\"Order Mode\">\n          <button class=\"mode-btn active\" data-mode=\"delivery\" type=\"button\">\n            <span>🛵</span>\n            <span>Home Delivery</span>\n          </button>\n          <button class=\"mode-btn\" data-mode=\"takeaway\" type=\"button\">\n            <span>🛍️</span>\n            <span>Self Pickup / Takeaway</span>\n          </button>\n          <button class=\"mode-btn\" data-mode=\"dinein\" type=\"button\">\n            <span>🍽️</span>\n            <span>Dine-In at Café</span>\n          </button>\n        </div>\n\n        <!-- Location Picker Row -->\n        <div class=\"location-picker-row\" id=\"locationPickerRow\">\n          <button class=\"loc-btn active\" id=\"btnUseGeolocation\" type=\"button\">\n            <span>📍</span>\n            <span>Detect My Current Location</span>\n          </button>\n          <button class=\"loc-btn\" id=\"btnEnterManualAddress\" type=\"button\">\n            <span>✏️</span>\n            <span>Enter Address Manually</span>\n          </button>\n        </div>\n\n        <!-- Leaflet Map Preview inside Checkout -->\n        <div class=\"checkout-map-container\" id=\"checkoutMapContainer\">\n          <div id=\"checkoutLeafletMap\" style=\"width:100%; height:100%;\"></div>\n        </div>\n\n        <div class=\"map-distance-badge\" id=\"mapDistanceBadge\">\n          <span id=\"mapDistanceText\">Calculating delivery distance from café...</span>\n          <span id=\"mapEtaText\">ETA: ~30-40 min</span>\n        </div>\n\n        <!-- Checkout Form -->\n        <form id=\"checkoutForm\" novalidate>\n          <div class=\"checkout-form-grid\">\n            <div class=\"form-group\">\n              <label class=\"form-label\" for=\"custName\">Full Name *</label>\n              <input type=\"text\" id=\"custName\" class=\"form-input\" placeholder=\"e.g. Rahul Sen\" required />\n              <div class=\"form-error-msg\">Please enter your name</div>\n            </div>\n\n            <div class=\"form-group\">\n              <label class=\"form-label\" for=\"custPhone\">Mobile Number (10 digits) *</label>\n              <input type=\"tel\" id=\"custPhone\" class=\"form-input\" placeholder=\"e.g. 9876543210\" pattern=\"[6-9][0-9]{9}\" required />\n              <div class=\"form-error-msg\">Enter a valid 10-digit Indian phone number</div>\n            </div>\n\n            <div class=\"form-group form-group-full\" id=\"addressFieldGroup\">\n              <label class=\"form-label\" for=\"custAddress\">Flat / House No. / Building *</label>\n              <input type=\"text\" id=\"custAddress\" class=\"form-input\" placeholder=\"e.g. Flat 3B, Sunshine Apartments\" required />\n              <div class=\"form-error-msg\">Please enter building details</div>\n            </div>\n\n            <div class=\"form-group\" id=\"localityFieldGroup\">\n              <label class=\"form-label\" for=\"custLocality\">Locality / Street / Landmark *</label>\n              <input type=\"text\" id=\"custLocality\" class=\"form-input\" placeholder=\"e.g. City Centre Road, Haldia\" required />\n              <div class=\"form-error-msg\">Please enter locality</div>\n            </div>\n\n            <div class=\"form-group\" id=\"pincodeFieldGroup\">\n              <label class=\"form-label\" for=\"custPin\">PIN Code *</label>\n              <input type=\"text\" id=\"custPin\" class=\"form-input\" placeholder=\"721657\" pattern=\"[0-9]{6}\" required />\n              <div class=\"form-error-msg\">Enter a valid 6-digit PIN code</div>\n            </div>\n\n            <div class=\"form-group form-group-full\">\n              <label class=\"form-label\" for=\"custNotes\">Special Delivery / Cooking Instructions (Optional)</label>\n              <input type=\"text\" id=\"custNotes\" class=\"form-input\" placeholder=\"e.g. Less spicy, ring the doorbell twice, please keep at the door\" />\n            </div>\n          </div>\n\n          <!-- Payment Options -->\n          <div class=\"payment-selector\">\n            <label class=\"form-label\">Payment Method *</label>\n            <div class=\"payment-options-grid\">\n              <label class=\"payment-card-option active\">\n                <input type=\"radio\" name=\"paymentMethod\" value=\"cod\" checked style=\"accent-color:var(--vibrant-orange);\" />\n                <span class=\"payment-icon\">💵</span>\n                <div>\n                  <div class=\"payment-name\">Cash on Delivery / Pickup</div>\n                  <div class=\"payment-desc\">Pay cash or UPI on delivery</div>\n                </div>\n              </label>\n\n              <label class=\"payment-card-option\">\n                <input type=\"radio\" name=\"paymentMethod\" value=\"upi\" style=\"accent-color:var(--vibrant-orange);\" />\n                <span class=\"payment-icon\">📱</span>\n                <div>\n                  <div class=\"payment-name\">Instant UPI Payment</div>\n                  <div class=\"payment-desc\">Pay via GPay, PhonePe, Paytm (Demo/Live)</div>\n                </div>\n              </label>\n            </div>\n          </div>\n\n          <!-- Final Review Box -->\n          <div class=\"checkout-summary-box\">\n            <div class=\"checkout-summary-title\">Order Bill Breakdown</div>\n            <div class=\"cart-summary-line\">\n              <span>Items Total:</span>\n              <strong id=\"chkSummarySubtotal\">₹0</strong>\n            </div>\n            <div class=\"cart-summary-line\">\n              <span>GST Tax (5%):</span>\n              <span id=\"chkSummaryTax\">₹0</span>\n            </div>\n            <div class=\"cart-summary-line\">\n              <span>Delivery Fee:</span>\n              <span id=\"chkSummaryDelivery\">₹30</span>\n            </div>\n            <div class=\"cart-total-line\" style=\"margin-bottom:0;\">\n              <span>Grand Total:</span>\n              <span id=\"chkSummaryTotal\">₹0</span>\n            </div>\n          </div>\n\n          <button type=\"submit\" class=\"btn btn-primary checkout-btn\" id=\"confirmOrderBtn\" style=\"font-size:1.15rem; padding:1.05rem;\">\n            Place Order Now →\n          </button>\n        </form>\n      </div>\n    </div>\n  </div>\n\n  <!-- Toast Container -->\n  <div class=\"toast-container\" id=\"toastContainer\" aria-live=\"polite\"></div>\n\n  <!-- Back To Top -->\n  <button class=\"back-to-top\" id=\"backToTop\" aria-label=\"Scroll to top of page\">↑</button>\n\n  <!-- Leaflet Map JS -->\n  <script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\" integrity=\"sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=\" crossorigin=\"\"></script>\n\n  <!-- Supabase JS CDN (v2) -->\n  <script src=\"https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2\"></script>\n\n  <!-- Application Logic (ES Module) -->\n  <script type=\"module\" src=\"script.js\"></script>\n</body>\n</html>\n","Description":"Updated index.html featuring enhanced navbar with cart badge, hero section, announcement strip, category banners, dynamic food menu with search and filters, bestsellers, responsive cart drawer, and interactive checkout modal with Leaflet map.","Overwrite":true,"TargetFile":"C:\\Users\\Lenovo\\.gemini\\antigravity\\scratch\\brew-and-bloom\\index.html","toolAction":"Updating index.html","toolSummary":"Complete modern index.html"}}]}

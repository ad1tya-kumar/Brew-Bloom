the bestsellers sections, along with their accents, also need designated colors. Menu cards require warm cream with high-contrast text and interactive components will be assigned corresponding colors.\n\nUI components such as search bars, category filters, and checkout workflows must incorporate the defined palette; ensure proper color contrast and visual hierarchy for usability. The floating cart button and drawer require specific color treatment, especially the active badge. Checkout pages and the live order tracking section also require consideration for this palette.\n\n\n","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"/* ════════════════════════════════════════════════════════════\n   BREW & BLOOM CAFÉ — style.css\n   PREMIUM HIGH-CONTRAST PALETTE:\n   --forest-green:   #073B32  (primary deep forest green)\n   --forest-dark:    #042620  (darker forest tone)\n   --espresso:       #172421  (dark espresso / text & dark bg)\n   --espresso-2:     #0F1916  (deep charcoal espresso)\n   --vibrant-orange: #FF7629  (primary CTA & accent)\n   --golden-yellow:  #FFC247  (secondary CTA & bestseller tag)\n   --warm-cream:     #FFF8EC  (menu background & base surface)\n   --cream-soft:     #F7EEDD  (subtle card & hover tone)\n   --fresh-mint:     #D9F3E5  (accent badge & fresh indicator)\n   --mint-dark:      #1B7552  (mint text for contrast)\n   --coral-pink:     #FF6B6B  (promo banner & special tags)\n   --lavender:       #E5DBFF  (soft promo banner & special card)\n   --white:          #FFFFFF  (pure white card surfaces)\n   --text-dark:      #172421  (high contrast text on cream)\n   --text-muted:     #52605C  (secondary body text)\n   --text-light:     #FFF8EC  (text on dark surfaces)\n   ════════════════════════════════════════════════════════════ */\n\n*, *::before, *::after {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\n:root {\n  --forest-green:   #073B32;\n  --forest-dark:    #042620;\n  --espresso:       #172421;\n  --espresso-2:     #0F1916;\n  --vibrant-orange: #FF7629;\n  --orange-hover:   #E56015;\n  --golden-yellow:  #FFC247;\n  --golden-hover:   #EBB036;\n  --warm-cream:     #FFF8EC;\n  --cream-soft:     #F7EEDD;\n  --fresh-mint:     #D9F3E5;\n  --mint-dark:      #145A3E;\n  --coral-pink:     #FF6B6B;\n  --lavender:       #E5DBFF;\n  --white:          #FFFFFF;\n  --text-dark:      #172421;\n  --text-muted:     #5C6B67;\n  --text-light:     #FFF8EC;\n  --border-light:   rgba(23, 36, 33, 0.1);\n  --border-dark:    rgba(255, 248, 236, 0.15);\n\n  /* Legacy variable mappings for backward compatibility */\n  --cream:          var(--warm-cream);\n  --cream-dark:     var(--cream-soft);\n  --caramel:        var(--vibrant-orange);\n  --caramel-lt:     var(--golden-yellow);\n  --latte:          #7A583A;\n  --sand:           var(--cream-soft);\n  --sand-dark:      #E8DEC8;\n  --sage:           var(--forest-green);\n  --sage-lt:        var(--fresh-mint);\n  --text:           var(--text-dark);\n\n  --radius-sm:      8px;\n  --radius-md:      14px;\n  --radius-lg:      22px;\n  --radius-xl:      32px;\n  --shadow-sm:      0 2px 8px rgba(7, 59, 50, 0.08);\n  --shadow-md:      0 8px 24px rgba(7, 59, 50, 0.12);\n  --shadow-lg:      0 18px 48px rgba(7, 59, 50, 0.18);\n  --shadow-glow:    0 0 25px rgba(255, 118, 41, 0.4);\n  --nav-h:          76px;\n  --transition:     0.28s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\nhtml {\n  scroll-behavior: smooth;\n  scroll-padding-top: var(--nav-h);\n  font-size: 16px;\n  -webkit-text-size-adjust: 100%;\n}\n\nbody {\n  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  background: var(--warm-cream);\n  color: var(--text-dark);\n  line-height: 1.65;\n  overflow-x: hidden;\n}\n\nimg {\n  max-width: 100%;\n  display: block;\n}\n\na {\n  color: inherit;\n  text-decoration: none;\n}\n\nbutton {\n  cursor: pointer;\n  font-family: inherit;\n  border: none;\n  background: none;\n}\n\nul { list-style: none; }\naddress { font-style: normal; }\n\n/* ── ACCESSIBILITY / FOCUS ─────────────────────────────── */\n:focus-visible {\n  outline: 3px solid var(--vibrant-orange);\n  outline-offset: 3px;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* ── TYPOGRAPHY ────────────────────────────────────────── */\nh1, h2, h3, h4, h5 {\n  font-family: 'Playfair Display', Georgia, serif;\n  line-height: 1.25;\n  color: var(--espresso);\n}\n\n.section-eyebrow {\n  font-family: 'Dancing Script', cursive;\n  font-size: 1.35rem;\n  color: var(--vibrant-orange);\n  display: block;\n  margin-bottom: 0.4rem;\n  letter-spacing: 0.02em;\n}\n\n.section-title {\n  font-size: clamp(2.1rem, 4.2vw, 3rem);\n  font-weight: 700;\n  margin-bottom: 1rem;\n  color: var(--forest-green);\n}\n\n.section-desc {\n  color: var(--text-muted);\n  max-width: 60ch;\n  margin: 0 auto;\n  font-size: 1.05rem;\n}\n\n.section-header {\n  text-align: center;\n  margin-bottom: 3.5rem;\n}\n\n/* ── CONTAINER & SECTION ───────────────────────────────── */\n.container {\n  max-width: 1240px;\n  margin: 0 auto;\n  padding: 0 1.5rem;\n}\n\n.section {\n  padding: 5.5rem 0;\n}\n\n/* ── BUTTONS ───────────────────────────────────────────── */\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.6rem;\n  padding: 0.75rem 1.75rem;\n  border-radius: 100px;\n  font-weight: 600;\n  font-size: 0.95rem;\n  letter-spacing: 0.02em;\n  transition: all var(--transition);\n  white-space: nowrap;\n  cursor: pointer;\n  border: 2px solid transparent;\n  user-select: none;\n}\n\n.btn-lg {\n  padding: 0.95rem 2.2rem;\n  font-size: 1.05rem;\n}\n\n.btn-sm {\n  padding: 0.45rem 1.15rem;\n  font-size: 0.85rem;\n}\n\n.btn-primary {\n  background: var(--vibrant-orange);\n  color: var(--white);\n  border-color: var(--vibrant-orange);\n  box-shadow: 0 4px 14px rgba(255, 118, 41, 0.3);\n}\n\n.btn-primary:hover, .btn-primary:focus-visible {\n  background: var(--orange-hover);\n  border-color: var(--orange-hover);\n  transform: translateY(-2px);\n  box-shadow: 0 8px 24px rgba(255, 118, 41, 0.45);\n}\n\n.btn-golden {\n  background: var(--golden-yellow);\n  color: var(--espresso);\n  border-color: var(--golden-yellow);\n  font-weight: 700;\n}\n\n.btn-golden:hover, .btn-golden:focus-visible {\n  background: var(--golden-hover);\n  border-color: var(--golden-hover);\n  transform: translateY(-2px);\n  box-shadow: 0 8px 20px rgba(255, 194, 71, 0.4);\n}\n\n.btn-forest {\n  background: var(--forest-green);\n  color: var(--warm-cream);\n  border-color: var(--forest-green);\n}\n\n.btn-forest:hover, .btn-forest:focus-visible {\n  background: var(--forest-dark);\n  border-color: var(--forest-dark);\n  transform: translateY(-2px);\n}\n\n.btn-ghost {\n  background: rgba(255, 255, 255, 0.12);\n  color: var(--white);\n  border-color: rgba(255, 255, 255, 0.6);\n  backdrop-filter: blur(10px);\n}\n\n.btn-ghost:hover, .btn-ghost:focus-visible {\n  background: rgba(255, 255, 255, 0.25);\n  border-color: var(--white);\n  transform: translateY(-2px);\n}\n\n.btn-whatsapp {\n  background: #25D366;\n  color: #fff;\n  border-color: #25D366;\n  font-weight: 700;\n}\n\n.btn-whatsapp:hover, .btn-whatsapp:focus-visible {\n  background: #128C7E;\n  border-color: #128C7E;\n  transform: translateY(-2px);\n  box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);\n}\n\n.btn-order {\n  background: var(--vibrant-orange);\n  color: var(--white);\n  border-color: var(--vibrant-orange);\n  font-size: 0.85rem;\n  padding: 0.45rem 1rem;\n}\n\n.btn-order:hover, .btn-order:focus-visible {\n  background: var(--espresso);\n  border-color: var(--espresso);\n  transform: translateY(-1px);\n}\n\n/* ════════════════════════════════════════════════════════════\n   STICKY NAVIGATION\n   ════════════════════════════════════════════════════════════ */\n.navbar {\n  position: fixed;\n  top: 0; left: 0; right: 0;\n  z-index: 1000;\n  height: var(--nav-h);\n  background: rgba(23, 36, 33, 0.85);\n  backdrop-filter: blur(18px);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n  transition: all var(--transition);\n}\n\n.navbar.scrolled {\n  background: rgba(7, 59, 50, 0.96);\n  box-shadow: 0 4px 20px rgba(4, 38, 32, 0.25);\n}\n\n.nav-container {\n  max-width: 1240px;\n  margin: 0 auto;\n  padding: 0 1.5rem;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  gap: 1.5rem;\n}\n\n.nav-logo {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  flex-shrink: 0;\n  text-decoration: none;\n}\n\n.logo-icon {\n  font-size: 2rem;\n  line-height: 1;\n  filter: drop-shadow(0 2px 6px rgba(0,0,0,0.3));\n}\n\n.logo-text {\n  display: flex;\n  flex-direction: column;\n  line-height: 1.1;\n}\n\n.logo-name {\n  font-family: 'Playfair Display', serif;\n  font-size: 1.25rem;\n  font-weight: 700;\n  color: var(--warm-cream);\n  letter-spacing: 0.02em;\n}\n\n.logo-tagline {\n  font-size: 0.6rem;\n  letter-spacing: 0.28em;\n  font-weight: 600;\n  color: var(--golden-yellow);\n}\n\n.nav-links {\n  display: flex;\n  align-items: center;\n  gap: 0.35rem;\n  margin-left: auto;\n}\n\n.nav-link {\n  padding: 0.45rem 0.95rem;\n  border-radius: 100px;\n  font-size: 0.92rem;\n  font-weight: 500;\n  color: rgba(255, 248, 236, 0.88);\n  transition: all var(--transition);\n}\n\n.nav-link:hover, .nav-link.active {\n  color: var(--golden-yellow);\n  background: rgba(255, 255, 255, 0.1);\n}\n\n.nav-actions {\n  display: flex;\n  align-items: center;\n  gap: 0.85rem;\n}\n\n/* Cart Trigger Button */\n.cart-trigger-btn {\n  position: relative;\n  background: var(--vibrant-orange);\n  color: var(--white);\n  padding: 0.55rem 1.15rem;\n  border-radius: 100px;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-weight: 700;\n  font-size: 0.9rem;\n  transition: all var(--transition);\n  box-shadow: 0 4px 14px rgba(255, 118, 41, 0.35);\n}\n\n.cart-trigger-btn:hover {\n  background: var(--orange-hover);\n  transform: translateY(-2px);\n  box-shadow: 0 6px 20px rgba(255, 118, 41, 0.5);\n}\n\n.cart-badge {\n  background: var(--golden-yellow);\n  color: var(--espresso);\n  font-size: 0.75rem;\n  font-weight: 800;\n  width: 22px;\n  height: 22px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n}\n\n.cart-badge.bump {\n  transform: scale(1.35);\n}\n\n.hamburger {\n  display: none;\n  flex-direction: column;\n  justify-content: center;\n  gap: 5px;\n  width: 42px;\n  height: 42px;\n  padding: 8px;\n  border-radius: var(--radius-sm);\n  background: rgba(255, 255, 255, 0.08);\n}\n\n.ham-bar {\n  display: block;\n  width: 100%;\n  height: 2px;\n  background: var(--warm-cream);\n  border-radius: 2px;\n  transition: all var(--transition);\n}\n\n.hamburger.open .ham-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }\n.hamburger.open .ham-bar:nth-child(2) { opacity: 0; transform: scaleX(0); }\n.hamburger.open .ham-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }\n\n/* ════════════════════════════════════════════════════════════\n   HERO SECTION (Sophisticated Dark Espresso & Forest Green)\n   ════════════════════════════════════════════════════════════ */\n.hero {\n  position: relative;\n  min-height: 100dvh;\n  display: flex;\n  align-items: center;\n  overflow: hidden;\n  background: var(--espresso);\n}\n\n.hero-bg {\n  position: absolute;\n  inset: 0;\n  background: url('https://images.unsplash.com/photo-1501339847302-ac426a4a7cbb?w=1920&q=80&auto=format&fit=crop') center/cover no-repeat;\n  filter: brightness(0.65) saturate(1.1);\n  transform: scale(1.04);\n  transition: transform 10s ease-out;\n}\n\n.hero-overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(\n    135deg,\n    rgba(7, 59, 50, 0.88) 0%,\n    rgba(23, 36, 33, 0.82) 55%,\n    rgba(15, 25, 22, 0.92) 100%\n  );\n}\n\n.hero-content {\n  position: relative;\n  z-index: 2;\n  max-width: 1240px;\n  margin: 0 auto;\n  padding: 0 1.5rem;\n  padding-top: calc(var(--nav-h) + 2rem);\n  width: 100%;\n}\n\n.hero-eyebrow {\n  font-family: 'Dancing Script', cursive;\n  font-size: 1.6rem;\n  color: var(--golden-yellow);\n  display: inline-block;\n  margin-bottom: 1rem;\n  background: rgba(255, 194, 71, 0.12);\n  padding: 0.35rem 1.1rem;\n  border-radius: 100px;\n  border: 1px solid rgba(255, 194, 71, 0.25);\n}\n\n.hero-headline {\n  font-size: clamp(2.8rem, 6.5vw, 4.8rem);\n  font-weight: 700;\n  color: var(--white);\n  line-height: 1.12;\n  margin-bottom: 1.5rem;\n}\n\n.hero-headline em {\n  font-style: italic;\n  color: var(--golden-yellow);\n}\n\n.hero-desc {\n  color: rgba(255, 248, 236, 0.88);\n  font-size: 1.15rem;\n  max-width: 52ch;\n  margin-bottom: 2.4rem;\n  line-height: 1.75;\n}\n\n.hero-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 1rem;\n  margin-bottom: 3.5rem;\n}\n\n.hero-badges {\n  display: flex;\n  align-items: center;\n  gap: 1.8rem;\n  background: rgba(7, 59, 50, 0.55);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  backdrop-filter: blur(12px);\n  padding: 0.85rem 1.6rem;\n  border-radius: var(--radius-lg);\n  width: fit-content;\n}\n\n.badge {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n}\n\n.badge-num {\n  font-family: 'Playfair Display', serif;\n  font-size: 1.35rem;\n  font-weight: 700;\n  color: var(--golden-yellow);\n}\n\n.badge-label {\n  font-size: 0.72rem;\n  color: rgba(255, 248, 236, 0.75);\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n\n.badge-sep {\n  width: 1px;\n  height: 38px;\n  background: rgba(255, 255, 255, 0.15);\n}\n\n.hero-scroll-hint {\n  position: absolute;\n  bottom: 2.2rem;\n  left: 50%;\n  transform: translateX(-50%);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.4rem;\n  color: rgba(255, 248, 236, 0.5);\n  font-size: 0.7rem;\n  letter-spacing: 0.15em;\n  text-transform: uppercase;\n}\n\n.scroll-arrow {\n  width: 18px;\n  height: 18px;\n  border-right: 2px solid rgba(255, 248, 236, 0.5);\n  border-bottom: 2px solid rgba(255, 248, 236, 0.5);\n  transform: rotate(45deg);\n  animation: bounce 1.8s ease infinite;\n}\n\n/* ════════════════════════════════════════════════════════════\n   ANNOUNCEMENT STRIP (Forest Green & Golden)\n   ════════════════════════════════════════════════════════════ */\n.announcement-strip {\n  background: var(--forest-green);\n  border-top: 1px solid rgba(255, 194, 71, 0.2);\n  border-bottom: 1px solid rgba(255, 194, 71, 0.2);\n  padding: 0.85rem 0;\n  overflow: hidden;\n  white-space: nowrap;\n}\n\n.strip-track {\n  display: inline-flex;\n  animation: marquee 32s linear infinite;\n}\n\n.strip-track span {\n  color: var(--golden-yellow);\n  font-size: 0.92rem;\n  font-weight: 600;\n  letter-spacing: 0.04em;\n  padding-right: 2.5rem;\n}\n\n/* ════════════════════════════════════════════════════════════\n   PROMOTIONAL CATEGORY BANNERS\n   ════════════════════════════════════════════════════════════ */\n.promo-banners-section {\n  background: var(--warm-cream);\n  padding: 3.5rem 0 1.5rem;\n}\n\n.promo-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 1.25rem;\n}\n\n.promo-card {\n  position: relative;\n  height: 240px;\n  border-radius: var(--radius-lg);\n  overflow: hidden;\n  box-shadow: var(--shadow-sm);\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  padding: 1.5rem;\n  color: var(--white);\n  text-decoration: none;\n  transition: transform var(--transition), box-shadow var(--transition);\n}\n\n.promo-card:hover {\n  transform: translateY(-6px);\n  box-shadow: var(--shadow-md);\n}\n\n.promo-card-bg {\n  position: absolute;\n  inset: 0;\n  background-size: cover;\n  background-position: center;\n  transition: transform 0.6s ease;\n}\n\n.promo-card:hover .promo-card-bg {\n  transform: scale(1.08);\n}\n\n.promo-card-overlay {\n  position: absolute;\n  inset: 0;\n  background: linear-gradient(180deg, rgba(7, 59, 50, 0.1) 0%, rgba(23, 36, 33, 0.85) 100%);\n}\n\n.promo-tag {\n  position: absolute;\n  top: 1rem;\n  left: 1rem;\n  z-index: 2;\n  font-size: 0.7rem;\n  font-weight: 800;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  padding: 0.25rem 0.65rem;\n  border-radius: 100px;\n  background: var(--vibrant-orange);\n  color: var(--white);\n}\n\n.promo-card-content {\n  position: relative;\n  z-index: 2;\n}\n\n.promo-card-title {\n  font-family: 'Playfair Display', serif;\n  font-size: 1.25rem;\n  font-weight: 700;\n  color: var(--white);\n  margin-bottom: 0.25rem;\n}\n\n.promo-card-sub {\n  font-size: 0.78rem;\n  color: rgba(255, 248, 236, 0.85);\n  margin-bottom: 0.6rem;\n  line-height: 1.4;\n}\n\n.promo-card-cta {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n  font-size: 0.75rem;\n  font-weight: 700;\n  color: var(--golden-yellow);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n/* ════════════════════════════════════════════════════════════\n   MENU SECTION (Warm Cream Surface & Food Cards)\n   ════════════════════════════════════════════════════════════ */\n.menu-section {\n  background: var(--warm-cream);\n  position: relative;\n}\n\n/* Filter, Search & Sort Bar */\n.menu-toolbar {\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n  margin-bottom: 2.8rem;\n}\n\n.menu-search-sort-row {\n  display: flex;\n  gap: 1rem;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.menu-search-box {\n  position: relative;\n  flex: 1;\n  min-width: 260px;\n}\n\n.menu-search-input {\n  width: 100%;\n  padding: 0.85rem 1.2rem 0.85rem 2.8rem;\n  border-radius: 100px;\n  border: 1.5px solid var(--border-light);\n  background: var(--white);\n  font-size: 0.95rem;\n  color: var(--espresso);\n  transition: all var(--transition);\n  box-shadow: var(--shadow-sm);\n}\n\n.menu-search-input:focus {\n  outline: none;\n  border-color: var(--vibrant-orange);\n  box-shadow: 0 0 0 3px rgba(255, 118, 41, 0.15);\n}\n\n.search-icon {\n  position: absolute;\n  left: 1.1rem;\n  top: 50%;\n  transform: translateY(-50%);\n  font-size: 1.1rem;\n  color: var(--text-muted);\n  pointer-events: none;\n}\n\n.menu-filter-controls {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  flex-wrap: wrap;\n}\n\n.veg-toggle-label {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.55rem;\n  cursor: pointer;\n  background: var(--white);\n  padding: 0.65rem 1.1rem;\n  border-radius: 100px;\n  border: 1.5px solid var(--border-light);\n  font-size: 0.88rem;\n  font-weight: 600;\n  color: var(--forest-green);\n  user-select: none;\n  box-shadow: var(--shadow-sm);\n}\n\n.veg-icon-badge {\n  width: 16px;\n  height: 16px;\n  border: 2px solid #27AE60;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 4px;\n}\n\n.veg-icon-dot {\n  width: 7px;\n  height: 7px;\n  background: #27AE60;\n  border-radius: 50%;\n}\n\n.sort-select {\n  padding: 0.75rem 1.3rem;\n  border-radius: 100px;\n  border: 1.5px solid var(--border-light);\n  background: var(--white);\n  font-size: 0.88rem;\n  font-weight: 600;\n  color: var(--espresso);\n  cursor: pointer;\n  box-shadow: var(--shadow-sm);\n}\n\n.sort-select:focus {\n  outline: none;\n  border-color: var(--vibrant-orange);\n}\n\n/* Category Filter Chips */\n.menu-category-chips {\n  display: flex;\n  gap: 0.6rem;\n  overflow-x: auto;\n  padding-bottom: 0.5rem;\n  scrollbar-width: none;\n}\n\n.menu-category-chips::-webkit-scrollbar { display: none; }\n\n.chip-btn {\n  padding: 0.65rem 1.35rem;\n  border-radius: 100px;\n  font-size: 0.92rem;\n  font-weight: 600;\n  color: var(--forest-green);\n  background: var(--white);\n  border: 1.5px solid var(--border-light);\n  transition: all var(--transition);\n  white-space: nowrap;\n  box-shadow: var(--shadow-sm);\n}\n\n.chip-btn:hover {\n  background: var(--cream-soft);\n  border-color: var(--forest-green);\n}\n\n.chip-btn.active {\n  background: var(--forest-green);\n  color: var(--warm-cream);\n  border-color: var(--forest-green);\n  box-shadow: 0 4px 14px rgba(7, 59, 50, 0.25);\n}\n\n/* Dynamic Menu Grid */\n.dynamic-menu-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n  gap: 1.75rem;\n}\n\n/* Food Item Card */\n.food-card {\n  background: var(--white);\n  border-radius: var(--radius-lg);\n  overflow: hidden;\n  box-shadow: var(--shadow-sm);\n  border: 1px solid var(--border-light);\n  display: flex;\n  flex-direction: column;\n  transition: transform var(--transition), box-shadow var(--transition);\n  position: relative;\n}\n\n.food-card:hover {\n  transform: translateY(-6px);\n  box-shadow: var(--shadow-md);\n}\n\n.food-card-media {\n  position: relative;\n  height: 195px;\n  overflow: hidden;\n  background: var(--cream-soft);\n}\n\n.food-card-img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.food-card:hover .food-card-img {\n  transform: scale(1.08);\n}\n\n.food-card-fallback {\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 3.5rem;\n}\n\n.food-card-badges {\n  position: absolute;\n  top: 0.75rem;\n  left: 0.75rem;\n  right: 0.75rem;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  pointer-events: none;\n}\n\n.badge-bestseller {\n  background: var(--golden-yellow);\n  color: var(--espresso);\n  font-size: 0.68rem;\n  font-weight: 800;\n  padding: 0.25rem 0.65rem;\n  border-radius: 100px;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  box-shadow: 0 2px 8px rgba(0,0,0,0.15);\n}\n\n.badge-veg {\n  background: rgba(255, 255, 255, 0.95);\n  padding: 4px;\n  border-radius: 4px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 2px 6px rgba(0,0,0,0.12);\n}\n\n.food-card-body {\n  padding: 1.3rem;\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n}\n\n.food-card-title {\n  font-family: 'Playfair Display', serif;\n  font-size: 1.15rem;\n  font-weight: 700;\n  color: var(--espresso);\n  margin-bottom: 0.4rem;\n}\n\n.food-card-desc {\n  font-size: 0.85rem;\n  color: var(--text-muted);\n  line-height: 1.5;\n  margin-bottom: 1.25rem;\n  flex: 1;\n}\n\n.food-card-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.75rem;\n  padding-top: 0.75rem;\n  border-top: 1px solid var(--border-light);\n}\n\n.food-card-price {\n  font-family: 'Playfair Display', serif;\n  font-size: 1.35rem;\n  font-weight: 800;\n  color: var(--forest-green);\n}\n\n/* Add / Quantity Button */\n.add-btn {\n  background: var(--vibrant-orange);\n  color: var(--white);\n  padding: 0.48rem 1.15rem;\n  border-radius: 100px;\n  font-weight: 700;\n  font-size: 0.85rem;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.4rem;\n  transition: all var(--transition);\n  box-shadow: 0 2px 8px rgba(255, 118, 41, 0.25);\n}\n\n.add-btn:hover {\n  background: var(--orange-hover);\n  transform: translateY(-1px);\n  box-shadow: 0 4px 12px rgba(255, 118, 41, 0.4);\n}\n\n.qty-counter {\n  display: inline-flex;\n  align-items: center;\n  background: var(--forest-green);\n  border-radius: 100px;\n  padding: 0.15rem;\n  color: var(--white);\n}\n\n.qty-btn {\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.15);\n  color: var(--white);\n  font-size: 1.05rem;\n  font-weight: 700;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  transition: background var(--transition);\n}\n\n.qty-btn:hover {\n  background: var(--vibrant-orange);\n}\n\n.qty-val {\n  min-width: 26px;\n  text-align: center;\n  font-size: 0.9rem;\n  font-weight: 700;\n}\n\n.empty-menu-alert {\n  text-align: center;\n  padding: 3rem;\n  grid-column: 1 / -1;\n  background: var(--white);\n  border-radius: var(--radius-lg);\n  border: 1px dashed var(--border-light);\n}\n\n.empty-menu-icon {\n  font-size: 3rem;\n  margin-bottom: 0.8rem;\n  display: block;\n}\n\n/* ════════════════════════════════════════════════════════════\n   SHOPPING CART DRAWER\n   ════════════════════════════════════════════════════════════ */\n.cart-drawer-backdrop {\n  position: fixed;\n  inset: 0;\n  background: rgba(15, 25, 22, 0.65);\n  backdrop-filter: blur(6px);\n  z-index: 2000;\n  opacity: 0;\n  visibility: hidden;\n  transition: all var(--transition);\n}\n\n.cart-drawer-backdrop.active {\n  opacity: 1;\n  visibility: visible;\n}\n\n.cart-drawer {\n  position: fixed;\n  top: 0;\n  right: 0;\n  bottom: 0;\n  width: 100%;\n  max-width: 440px;\n  background: var(--white);\n  z-index: 2001;\n  box-shadow: -8px 0 32px rgba(4, 38, 32, 0.25);\n  display: flex;\n  flex-direction: column;\n  transform: translateX(100%);\n  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.cart-drawer.active {\n  transform: translateX(0);\n}\n\n.cart-drawer-header {\n  padding: 1.4rem 1.6rem;\n  background: var(--forest-green);\n  color: var(--warm-cream);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.cart-drawer-title {\n  font-family: 'Playfair Display', serif;\n  font-size: 1.35rem;\n  font-weight: 700;\n  color: var(--white);\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n}\n\n.cart-close-btn {\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.15);\n  color: var(--white);\n  font-size: 1.25rem;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  transition: background var(--transition);\n}\n\n.cart-close-btn:hover {\n  background: var(--vibrant-orange);\n}\n\n.cart-drawer-body {\n  padding: 1.4rem 1.6rem;\n  overflow-y: auto;\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 1.2rem;\n}\n\n.cart-item-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.75rem;\n  padding-bottom: 1rem;\n  border-bottom: 1px solid var(--border-light);\n}\n\n.cart-item-info {\n  flex: 1;\n}\n\n.cart-item-name {\n  font-weight: 700;\n  font-size: 0.95rem;\n  color: var(--espresso);\n  margin-bottom: 0.2rem;\n}\n\n.cart-item-price {\n  font-size: 0.85rem;\n  color: var(--forest-green);\n  font-weight: 700;\n}\n\n.cart-item-remove {\n  color: #E74C3C;\n  font-size: 0.75rem;\n  text-decoration: underline;\n  cursor: pointer;\n  margin-top: 0.2rem;\n  display: inline-block;\n}\n\n.cart-special-instructions {\n  width: 100%;\n  padding: 0.75rem 1rem;\n  border-radius: var(--radius-sm);\n  border: 1.5px solid var(--border-light);\n  font-family: inherit;\n  font-size: 0.85rem;\n  resize: vertical;\n  min-height: 60px;\n  background: var(--warm-cream);\n  color: var(--espresso);\n}\n\n.cart-special-instructions:focus {\n  outline: none;\n  border-color: var(--vibrant-orange);\n}\n\n.cart-empty-state {\n  text-align: center;\n  padding: 4rem 1rem;\n  color: var(--text-muted);\n}\n\n.cart-empty-icon {\n  font-size: 3.8rem;\n  margin-bottom: 1rem;\n  display: block;\n}\n\n.cart-drawer-footer {\n  padding: 1.4rem 1.6rem;\n  background: var(--warm-cream);\n  border-top: 1px solid var(--border-light);\n}\n\n.cart-summary-line {\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.9rem;\n  color: var(--text-muted);\n  margin-bottom: 0.45rem;\n}\n\n.cart-total-line {\n  display: flex;\n  justify-content: space-between;\n  font-size: 1.25rem;\n  font-weight: 800;\n  color: var(--forest-green);\n  padding-top: 0.6rem;\n  margin-top: 0.6rem;\n  border-top: 1.5px dashed var(--border-light);\n  margin-bottom: 1.2rem;\n}\n\n.checkout-btn {\n  width: 100%;\n  padding: 0.95rem;\n  font-size: 1.05rem;\n}\n\n/* ════════════════════════════════════════════════════════════\n   CHECKOUT MODAL & PAGE\n   ════════════════════════════════════════════════════════════ */\n.checkout-modal-backdrop {\n  position: fixed;\n  inset: 0;\n  background: rgba(15, 25, 22, 0.75);\n  backdrop-filter: blur(8px);\n  z-index: 2100;\n  opacity: 0;\n  visibility: hidden;\n  transition: all var(--transition);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 1.5rem;\n  overflow-y: auto;\n}\n\n.checkout-modal-backdrop.active {\n  opacity: 1;\n  visibility: visible;\n}\n\n.checkout-modal {\n  background: var(--white);\n  border-radius: var(--radius-xl);\n  max-width: 820px;\n  width: 100%;\n  max-height: 90vh;\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  box-shadow: var(--shadow-lg);\n  position: relative;\n  margin: auto;\n}\n\n.checkout-modal-header {\n  padding: 1.4rem 2rem;\n  background: var(--forest-green);\n  color: var(--warm-cream);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.checkout-modal-title {\n  font-family: 'Playfair Display', serif;\n  font-size: 1.4rem;\n  font-weight: 700;\n  color: var(--white);\n}\n\n.checkout-modal-body {\n  padding: 2rem;\n  overflow-y: auto;\n}\n\n/* Delivery Mode Switcher */\n.delivery-mode-switcher {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 0.75rem;\n  margin-bottom: 1.75rem;\n}\n\n.mode-btn {\n  padding: 0.75rem;\n  border-radius: var(--radius-md);\n  border: 1.5px solid var(--border-light);\n  background: var(--warm-cream);\n  color: var(--forest-green);\n  font-weight: 700;\n  font-size: 0.9rem;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.35rem;\n  cursor: pointer;\n  transition: all var(--transition);\n}\n\n.mode-btn.active {\n  background: var(--forest-green);\n  color: var(--white);\n  border-color: var(--forest-green);\n  box-shadow: var(--shadow-sm);\n}\n\n/* Location picker row */\n.location-picker-row {\n  display: flex;\n  gap: 0.75rem;\n  margin-bottom: 1.25rem;\n  flex-wrap: wrap;\n}\n\n.loc-btn {\n  flex: 1;\n  min-width: 200px;\n  padding: 0.75rem 1rem;\n  border-radius: var(--radius-md);\n  border: 1.5px solid var(--border-light);\n  background: var(--warm-cream);\n  font-size: 0.88rem;\n  font-weight: 600;\n  color: var(--forest-green);\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  cursor: pointer;\n  transition: all var(--transition);\n}\n\n.loc-btn.active, .loc-btn:hover {\n  background: var(--fresh-mint);\n  border-color: var(--forest-green);\n}\n\n/* Leaflet Map in Checkout */\n.checkout-map-container {\n  height: 240px;\n  border-radius: var(--radius-md);\n  overflow: hidden;\n  margin-bottom: 1.5rem;\n  border: 1.5px solid var(--border-light);\n  box-shadow: var(--shadow-sm);\n}\n\n.map-distance-badge {\n  background: var(--fresh-mint);\n  color: var(--forest-dark);\n  padding: 0.5rem 1rem;\n  border-radius: var(--radius-sm);\n  font-size: 0.85rem;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 1.5rem;\n}\n\n/* Checkout Form Grid */\n.checkout-form-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 1.1rem;\n  margin-bottom: 1.75rem;\n}\n\n.form-group-full {\n  grid-column: 1 / -1;\n}\n\n.form-label {\n  display: block;\n  font-size: 0.82rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: var(--forest-green);\n  margin-bottom: 0.35rem;\n}\n\n.form-input {\n  width: 100%;\n  padding: 0.8rem 1rem;\n  border-radius: var(--radius-sm);\n  border: 1.5px solid var(--border-light);\n  background: var(--white);\n  color: var(--espresso);\n  font-size: 0.92rem;\n  font-family: inherit;\n  transition: all var(--transition);\n}\n\n.form-input:focus {\n  outline: none;\n  border-color: var(--vibrant-orange);\n  box-shadow: 0 0 0 3px rgba(255, 118, 41, 0.12);\n}\n\n.form-input.invalid {\n  border-color: #E74C3C;\n  background: #FDF2E9;\n}\n\n.form-error-msg {\n  font-size: 0.75rem;\n  color: #E74C3C;\n  margin-top: 0.25rem;\n  display: none;\n}\n\n.form-input.invalid + .form-error-msg {\n  display: block;\n}\n\n/* Payment Selector */\n.payment-selector {\n  margin-bottom: 1.75rem;\n}\n\n.payment-options-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 1rem;\n}\n\n.payment-card-option {\n  border: 2px solid var(--border-light);\n  border-radius: var(--radius-md);\n  padding: 1.1rem;\n  cursor: pointer;\n  background: var(--warm-cream);\n  display: flex;\n  align-items: center;\n  gap: 0.85rem;\n  transition: all var(--transition);\n}\n\n.payment-card-option:hover {\n  border-color: var(--vibrant-orange);\n}\n\n.payment-card-option.active {\n  border-color: var(--vibrant-orange);\n  background: rgba(255, 118, 41, 0.08);\n}\n\n.payment-icon {\n  font-size: 1.8rem;\n}\n\n.payment-name {\n  font-weight: 700;\n  font-size: 0.95rem;\n  color: var(--espresso);\n}\n\n.payment-desc {\n  font-size: 0.78rem;\n  color: var(--text-muted);\n}\n\n/* Order Summary Box inside Checkout */\n.checkout-summary-box {\n  background: var(--warm-cream);\n  border-radius: var(--radius-md);\n  padding: 1.25rem 1.5rem;\n  border: 1px solid var(--border-light);\n  margin-bottom: 1.75rem;\n}\n\n.checkout-summary-title {\n  font-size: 0.95rem;\n  font-weight: 700;\n  color: var(--forest-green);\n  margin-bottom: 0.8rem;\n}\n\n/* ════════════════════════════════════════════════════════════\n   ORDER CONFIRMATION & LIVE DELIVERY TRACKING\n   ════════════════════════════════════════════════════════════ */\n.tracking-container {\n  max-width: 1080px;\n  margin: calc(var(--nav-h) + 2rem) auto 4rem;\n  padding: 0 1.5rem;\n}\n\n.tracking-header-card {\n  background: var(--forest-green);\n  color: var(--warm-cream);\n  border-radius: var(--radius-xl);\n  padding: 2.5rem;\n  margin-bottom: 2rem;\n  position: relative;\n  overflow: hidden;\n  box-shadow: var(--shadow-md);\n}\n\n.demo-tracking-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  background: var(--golden-yellow);\n  color: var(--espresso);\n  font-size: 0.75rem;\n  font-weight: 800;\n  padding: 0.35rem 0.9rem;\n  border-radius: 100px;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  margin-bottom: 1rem;\n}\n\n.tracking-order-id {\n  font-family: 'Playfair Display', serif;\n  font-size: 2.2rem;\n  font-weight: 700;\n  color: var(--white);\n  margin-bottom: 0.5rem;\n}\n\n.tracking-eta-box {\n  display: flex;\n  gap: 2rem;\n  margin-top: 1.5rem;\n  padding-top: 1.5rem;\n  border-top: 1px solid rgba(255, 255, 255, 0.15);\n  flex-wrap: wrap;\n}\n\n.eta-item {\n  display: flex;\n  flex-direction: column;\n}\n\n.eta-val {\n  font-size: 1.8rem;\n  font-weight: 800;\n  color: var(--golden-yellow);\n  line-height: 1.1;\n}\n\n.eta-lbl {\n  font-size: 0.75rem;\n  color: rgba(255, 248, 236, 0.75);\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n\n/* Status Timeline (6 Stages) */\n.timeline-card {\n  background: var(--white);\n  border-radius: var(--radius-xl);\n  padding: 2.2rem;\n  margin-bottom: 2rem;\n  box-shadow: var(--shadow-sm);\n  border: 1px solid var(--border-light);\n}\n\n.timeline-stages {\n  display: flex;\n  justify-content: space-between;\n  position: relative;\n  margin-top: 1rem;\n}\n\n.timeline-stages::before {\n  content: '';\n  position: absolute;\n  top: 20px;\n  left: 30px;\n  right: 30px;\n  height: 4px;\n  background: var(--cream-soft);\n  z-index: 1;\n}\n\n.timeline-progress-bar {\n  position: absolute;\n  top: 20px;\n  left: 30px;\n  height: 4px;\n  background: var(--vibrant-orange);\n  z-index: 2;\n  transition: width 0.5s ease;\n}\n\n.stage-item {\n  position: relative;\n  z-index: 3;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  text-align: center;\n  max-width: 100px;\n}\n\n.stage-circle {\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  background: var(--white);\n  border: 3px solid var(--cream-soft);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.1rem;\n  margin-bottom: 0.6rem;\n  transition: all var(--transition);\n}\n\n.stage-item.completed .stage-circle {\n  background: var(--forest-green);\n  border-color: var(--forest-green);\n  color: var(--white);\n}\n\n.stage-item.active .stage-circle {\n  background: var(--vibrant-orange);\n  border-color: var(--vibrant-orange);\n  color: var(--white);\n  box-shadow: 0 0 0 6px rgba(255, 118, 41, 0.2);\n  animation: pulse 1.8s infinite;\n}\n\n.stage-name {\n  font-size: 0.78rem;\n  font-weight: 700;\n  color: var(--text-muted);\n}\n\n.stage-item.active .stage-name,\n.stage-item.completed .stage-name {\n  color: var(--espresso);\n}\n\n/* Live Map Card */\n.tracking-map-card {\n  background: var(--white);\n  border-radius: var(--radius-xl);\n  overflow: hidden;\n  box-shadow: var(--shadow-md);\n  margin-bottom: 2rem;\n  border: 1px solid var(--border-light);\n}\n\n.tracking-map-header {\n  padding: 1.25rem 1.8rem;\n  background: var(--warm-cream);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  border-bottom: 1px solid var(--border-light);\n}\n\n.live-indicator {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-size: 0.8rem;\n  font-weight: 700;\n  color: var(--forest-green);\n}\n\n.live-dot {\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background: #27AE60;\n  box-shadow: 0 0 0 4px rgba(39, 174, 96, 0.25);\n  animation: liveBlink 1.5s infinite;\n}\n\n#liveTrackingMap {\n  height: 420px;\n  width: 100%;\n}\n\n/* Driver Info Card */\n.driver-info-card {\n  background: var(--warm-cream);\n  border-radius: var(--radius-xl);\n  padding: 1.75rem;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1.5rem;\n  border: 1px solid var(--border-light);\n  margin-bottom: 2rem;\n}\n\n.driver-profile {\n  display: flex;\n  align-items: center;\n  gap: 1.25rem;\n}\n\n.driver-avatar {\n  width: 64px;\n  height: 64px;\n  border-radius: 50%;\n  background: var(--forest-green);\n  color: var(--warm-cream);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 2rem;\n}\n\n.driver-details h4 {\n  font-size: 1.15rem;\n  margin-bottom: 0.2rem;\n}\n\n.driver-details p {\n  font-size: 0.85rem;\n  color: var(--text-muted);\n}\n\n/* ════════════════════════════════════════════════════════════\n   BESTSELLERS SECTION (Deep Forest Green Background)\n   ════════════════════════════════════════════════════════════ */\n.bestsellers-section {\n  background: var(--forest-green);\n  color: var(--warm-cream);\n}\n\n.bestsellers-section .section-title {\n  color: var(--warm-cream);\n}\n\n.bestsellers-section .section-desc {\n  color: rgba(255, 248, 236, 0.75);\n}\n\n.bestsellers-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n  gap: 1.75rem;\n}\n\n.bestseller-card {\n  background: var(--espresso);\n  border-radius: var(--radius-lg);\n  overflow: hidden;\n  box-shadow: var(--shadow-sm);\n  transition: transform var(--transition), box-shadow var(--transition);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n.bestseller-card:hover {\n  transform: translateY(-8px);\n  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);\n}\n\n.bestseller-img-wrap {\n  height: 190px;\n  position: relative;\n  overflow: hidden;\n}\n\n.bestseller-img-wrap img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.6s ease;\n}\n\n.bestseller-card:hover .bestseller-img-wrap img {\n  transform: scale(1.08);\n}\n\n.bestseller-rank {\n  position: absolute;\n  top: 0.8rem;\n  left: 0.8rem;\n  background: var(--golden-yellow);\n  color: var(--espresso);\n  font-family: 'Playfair Display', serif;\n  font-size: 0.88rem;\n  font-weight: 800;\n  padding: 0.3rem 0.75rem;\n  border-radius: 100px;\n  box-shadow: 0 2px 8px rgba(0,0,0,0.25);\n}\n\n.bestseller-body {\n  padding: 1.35rem;\n}\n\n.bestseller-body h3 {\n  font-size: 1.15rem;\n  color: var(--warm-cream);\n  margin-bottom: 0.35rem;\n}\n\n.bestseller-body p {\n  font-size: 0.82rem;\n  color: rgba(255, 248, 236, 0.7);\n  margin-bottom: 1.1rem;\n}\n\n.bestseller-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.bestseller-price {\n  font-family: 'Playfair Display', serif;\n  font-size: 1.35rem;\n  font-weight: 800;\n  color: var(--golden-yellow);\n}\n\n/* ════════════════════════════════════════════════════════════\n   ABOUT SECTION\n   ════════════════════════════════════════════════════════════ */\n.about-section {\n  background: var(--warm-cream);\n}\n\n.about-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 4.5rem;\n  align-items: center;\n}\n\n.about-imagery {\n  position: relative;\n  height: 520px;\n}\n\n.about-img-main {\n  position: absolute;\n  top: 0; left: 0;\n  width: 76%;\n  height: 78%;\n  border-radius: var(--radius-xl);\n  box-shadow: var(--shadow-lg);\n  overflow: hidden;\n  background-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=800&q=80&auto=format&fit=crop');\n  background-size: cover;\n  background-position: center;\n}\n\n.about-img-accent {\n  position: absolute;\n  bottom: 0; right: 0;\n  width: 54%;\n  height: 50%;\n  border-radius: var(--radius-lg);\n  box-shadow: var(--shadow-lg);\n  border: 5px solid var(--warm-cream);\n  overflow: hidden;\n  background-image: url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?w=600&q=80&auto=format&fit=crop');\n  background-size: cover;\n  background-position: center;\n}\n\n.about-stat-card {\n  position: absolute;\n  top: 50%;\n  right: 0;\n  transform: translate(15%, -50%);\n  background: var(--forest-green);\n  color: var(--warm-cream);\n  padding: 1.25rem 1.6rem;\n  border-radius: var(--radius-md);\n  text-align: center;\n  box-shadow: var(--shadow-md);\n  z-index: 2;\n}\n\n.stat-num {\n  display: block;\n  font-family: 'Playfair Display', serif;\n  font-size: 2.2rem;\n  font-weight: 700;\n  color: var(--golden-yellow);\n  line-height: 1;\n}\n\n.stat-label {\n  font-size: 0.72rem;\n  opacity: 0.85;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  margin-top: 0.35rem;\n}\n\n.about-content { max-width: 520px; }\n\n.about-para {\n  color: var(--text-muted);\n  margin-bottom: 1.3rem;\n  line-height: 1.8;\n  font-size: 1.02rem;\n}\n\n.about-values {\n  display: flex;\n  flex-direction: column;\n  gap: 1.15rem;\n  margin: 2.2rem 0;\n}\n\n.value-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 1.1rem;\n}\n\n.value-icon {\n  font-size: 1.6rem;\n  flex-shrink: 0;\n  width: 48px;\n  height: 48px;\n  background: var(--fresh-mint);\n  border-radius: var(--radius-sm);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.value-item strong {\n  display: block;\n  font-size: 1rem;\n  color: var(--forest-green);\n  margin-bottom: 0.15rem;\n}\n\n.value-item p {\n  font-size: 0.85rem;\n  color: var(--text-muted);\n}\n\n/* ════════════════════════════════════════════════════════════\n   GALLERY SECTION (Dark Espresso)\n   ════════════════════════════════════════════════════════════ */\n.gallery-section {\n  background: var(--espresso-2);\n  padding: 5.5rem 0;\n}\n\n.gallery-section .section-eyebrow { color: var(--golden-yellow); }\n.gallery-section .section-title   { color: var(--warm-cream); }\n.gallery-section .section-desc    { color: rgba(255, 248, 236, 0.65); }\n\n.gallery-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 1.25rem;\n}\n\n.gallery-item {\n  position: relative;\n  border-radius: var(--radius-lg);\n  overflow: hidden;\n  cursor: pointer;\n  min-height: 240px;\n  display: flex;\n  align-items: flex-end;\n}\n\n.gallery-tall {\n  grid-row: span 2;\n  min-height: 500px;\n}\n\n.gallery-wide {\n  grid-column: span 2;\n}\n\n.gallery-img {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.6s ease;\n}\n\n.gallery-item:hover .gallery-img {\n  transform: scale(1.08);\n}\n\n.gallery-overlay {\n  position: relative;\n  z-index: 2;\n  width: 100%;\n  padding: 1.5rem;\n  background: linear-gradient(to top, rgba(15, 25, 22, 0.88) 0%, transparent 100%);\n}\n\n.gallery-label {\n  color: var(--white);\n  font-family: 'Playfair Display', serif;\n  font-size: 1.15rem;\n  font-weight: 700;\n}\n\n/* ════════════════════════════════════════════════════════════\n   LOCATION & CONTACT SECTION\n   ════════════════════════════════════════════════════════════ */\n.location-section {\n  background: var(--warm-cream);\n}\n\n.location-grid {\n  display: grid;\n  grid-template-columns: 1fr 1.35fr;\n  gap: 3.5rem;\n  align-items: start;\n}\n\n.location-info {\n  display: flex;\n  flex-direction: column;\n  gap: 1.4rem;\n}\n\n.info-card {\n  background: var(--white);\n  border-radius: var(--radius-lg);\n  padding: 1.6rem;\n  display: flex;\n  gap: 1.1rem;\n  align-items: flex-start;\n  box-shadow: var(--shadow-sm);\n  border: 1px solid var(--border-light);\n}\n\n.info-icon {\n  font-size: 1.6rem;\n  flex-shrink: 0;\n  width: 50px;\n  height: 50px;\n  background: var(--fresh-mint);\n  border-radius: var(--radius-sm);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.info-card h3 {\n  font-size: 1.05rem;\n  margin-bottom: 0.4rem;\n  color: var(--forest-green);\n}\n\n.info-card p {\n  color: var(--text-muted);\n  font-size: 0.9rem;\n  line-height: 1.6;\n}\n\n.hours-grid {\n  display: grid;\n  grid-template-columns: auto 1fr;\n  gap: 0.25rem 1.25rem;\n  font-size: 0.88rem;\n  color: var(--text-muted);\n}\n\n.map-container {\n  border-radius: var(--radius-xl);\n  overflow: hidden;\n  box-shadow: var(--shadow-md);\n  border: 1px solid var(--border-light);\n  height: 440px;\n}\n\n#locationLeafletMap {\n  width: 100%;\n  height: 100%;\n}\n\n/* ════════════════════════════════════════════════════════════\n   FOOTER (Dark Espresso)\n   ════════════════════════════════════════════════════════════ */\n.footer {\n  background: var(--espresso-2);\n  padding: 5rem 0 0;\n  color: var(--warm-cream);\n}\n\n.footer-grid {\n  display: grid;\n  grid-template-columns: 2fr 1fr 1fr 1.4fr;\n  gap: 3.5rem;\n  padding-bottom: 3.5rem;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n.footer-brand-desc {\n  color: rgba(255, 248, 236, 0.65);\n  font-size: 0.9rem;\n  margin-top: 1rem;\n  margin-bottom: 1.5rem;\n  max-width: 32ch;\n  line-height: 1.7;\n}\n\n.social-links {\n  display: flex;\n  gap: 0.75rem;\n}\n\n.social-link {\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  background: rgba(255, 255, 255, 0.08);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: rgba(255, 248, 236, 0.8);\n  transition: all var(--transition);\n}\n\n.social-link:hover {\n  background: var(--vibrant-orange);\n  color: var(--white);\n  transform: translateY(-3px);\n}\n\n.footer-heading {\n  font-family: 'Inter', sans-serif;\n  font-size: 0.8rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.12em;\n  color: var(--golden-yellow);\n  margin-bottom: 1.35rem;\n}\n\n.footer-links {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.footer-links a {\n  color: rgba(255, 248, 236, 0.7);\n  font-size: 0.9rem;\n  transition: color var(--transition);\n}\n\n.footer-links a:hover {\n  color: var(--golden-yellow);\n}\n\n.footer-bottom {\n  padding: 1.8rem 0;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n\n.footer-bottom p {\n  font-size: 0.82rem;\n  color: rgba(255, 248, 236, 0.45);\n  text-align: center;\n}\n\n/* ════════════════════════════════════════════════════════════\n   TOAST NOTIFICATIONS\n   ════════════════════════════════════════════════════════════ */\n.toast-container {\n  position: fixed;\n  bottom: 2rem;\n  left: 2rem;\n  z-index: 3000;\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n  pointer-events: none;\n}\n\n.toast {\n  pointer-events: all;\n  background: var(--espresso);\n  color: var(--white);\n  padding: 0.85rem 1.4rem;\n  border-radius: var(--radius-md);\n  font-size: 0.9rem;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  box-shadow: var(--shadow-lg);\n  border-left: 4px solid var(--vibrant-orange);\n  animation: slideToast 0.3s cubic-bezier(0.16, 1, 0.3, 1);\n  max-width: 380px;\n}\n\n.toast.success { border-left-color: #27AE60; }\n.toast.error   { border-left-color: #E74C3C; }\n\n/* ════════════════════════════════════════════════════════════\n   KEYFRAME ANIMATIONS\n   ════════════════════════════════════════════════════════════ */\n@keyframes slideToast {\n  from { transform: translateY(20px); opacity: 0; }\n  to   { transform: translateY(0); opacity: 1; }\n}\n\n@keyframes pulse {\n  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 118, 41, 0.4); }\n  50%      { box-shadow: 0 0 0 10px rgba(255, 118, 41, 0); }\n}\n\n@keyframes liveBlink {\n  0%, 100% { opacity: 1; transform: scale(1); }\n  50%      { opacity: 0.4; transform: scale(0.85); }\n}\n\n@keyframes bounce {\n  0%, 100% { transform: rotate(45deg) translateY(0); }\n  50%      { transform: rotate(45deg) translateY(6px); }\n}\n\n@keyframes marquee {\n  0%   { transform: translateX(0); }\n  100% { transform: translateX(-50%); }\n}\n\n/* ════════════════════════════════════════════════════════════\n   RESPONSIVE DESIGN (Tablets & Mobile)\n   ════════════════════════════════════════════════════════════ */\n@media (max-width: 960px) {\n  :root { --nav-h: 68px; }\n\n  .nav-links {\n    display: none;\n    position: fixed;\n    top: var(--nav-h);\n    left: 0; right: 0;\n    background: var(--forest-green);\n    flex-direction: column;\n    padding: 1.5rem;\n    gap: 0.5rem;\n    box-shadow: var(--shadow-lg);\n  }\n\n  .nav-links.open { display: flex; }\n\n  .nav-links .nav-link {\n    width: 100%;\n    padding: 0.75rem 1rem;\n  }\n\n  .hamburger { display: flex; }\n\n  .promo-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .about-grid, .location-grid {\n    grid-template-columns: 1fr;\n    gap: 3rem;\n  }\n\n  .about-imagery { height: 360px; }\n\n  .footer-grid {\n    grid-template-columns: 1fr 1fr;\n    gap: 2.5rem;\n  }\n\n  .checkout-form-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 600px) {\n  .section { padding: 4rem 0; }\n\n  .promo-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .dynamic-menu-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .timeline-stages {\n    flex-direction: column;\n    gap: 1.5rem;\n    align-items: flex-start;\n    padding-left: 2rem;\n  }\n\n  .timeline-stages::before, .timeline-progress-bar {\n    top: 0;\n    bottom: 0;\n    left: 42px;\n    width: 4px;\n    height: 100%;\n  }\n\n  .stage-item {\n    flex-direction: row;\n    gap: 1rem;\n    text-align: left;\n    max-width: none;\n  }\n\n  .delivery-mode-switcher {\n    grid-template-columns: 1fr;\n  }\n\n  .payment-options-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .footer-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .toast-container {\n    left: 1rem;\n    right: 1rem;\n    bottom: 1rem;\n  }\n}\n","Description":"Elevated stylesheet with the exact high-contrast palette tokens, food delivery components, category banners, cart drawer, checkout modal, live delivery map, and driver dashboard styles.","Overwrite":true,"TargetFile":"C:\\Users\\Lenovo\\.gemini\\antigravity\\scratch\\brew-and-bloom\\style.css","toolAction":"Updating style.css","toolSummary":"Elevate style.css"}}]}

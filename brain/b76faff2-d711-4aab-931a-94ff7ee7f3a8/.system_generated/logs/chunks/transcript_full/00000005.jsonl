:     return null;\n39:   }\n40: }\n41: \n42: export function getClient() { return _supabase; }\n43: \n44: // ── ORDER FUNCTIONS ─────────────────────────────────────────\n45: \n46: /**\n47:  * Place a new order.\n48:  * In demo mode: saves to localStorage and returns a fake order.\n49:  */\n50: export async function placeOrder(orderData) {\n51:   if (DEMO_MODE) return placeDemoOrder(orderData);\n52: \n53:   const sb = getClient();\n54:   const { data, error } = await sb.from('orders').insert([orderData]).select().single();\n55:   if (error) throw error;\n56:   return data;\n57: }\n58: \n59: /**\n60:  * Get order by id and token (prevents unauthorised access).\n61:  */\n62: export async function getOrder(orderId, token) {\n63:   if (DEMO_MODE) return getDemoOrder(orderId);\n64: \n65:   const sb = getClient();\n66:   const { data, error } = await sb\n67:     .from('orders')\n68:     .select('*, order_items(*)')\n69:     .eq('id', orderId)\n70:     .eq('tracking_token', token)\n71:     .single();\n72:   if (error) throw error;\n73:   return data;\n74: }\n75: \n76: /**\n77:  * Subscribe to real-time driver location for an order.\n78:  * Returns an unsubscribe function.\n79:  */\n80: export function subscribeToDriverLocation(orderId, onUpdate) {\n81:   if (DEMO_MODE) return () => {};\n82: \n83:   const sb = getClient();\n84:   const channel = sb\n85:     .channel(`driver-location-${orderId}`)\n86:     .on('postgres_changes', {\n87:       event: 'UPDATE',\n88:       schema: 'public',\n89:       table: 'driver_locations',\n90:       filter: `order_id=eq.${orderId}`,\n91:     }, payload => onUpdate(payload.new))\n92:     .subscribe();\n93: \n94:   return () => sb.removeChannel(channel);\n95: }\n96: \n97: /**\n98:  * Driver: push location update.\n99:  */\n100: export async function pushDriverLocation(orderId, lat, lng) {\n101:   if (DEMO_MODE) return;\n102:   const sb = getClient();\n103:   await sb.from('driver_locations').upsert({ order_id: orderId, lat, lng, updated_at:
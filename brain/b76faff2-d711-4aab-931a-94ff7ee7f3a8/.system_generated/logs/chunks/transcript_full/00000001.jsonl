�══════════════ */\n@media print {\n  .navbar, .hamburger, .back-to-top, .hero-scroll-hint,\n  .announcement-strip, .btn { display: none !important; }\n  body { background: #fff; color: #000; }\n  .section { padding: 2rem 0; }\n}\n","Description":"Complete CSS stylesheet with brand palette, responsive layouts, animations, and component styles for the café website.","Overwrite":false,"TargetFile":"C:\\Users\\Lenovo\\.gemini\\antigravity\\scratch\\brew-and-bloom\\style.css","toolAction":"Creating stylesheet","toolSummary":"Complete CSS stylesheet"}}]}

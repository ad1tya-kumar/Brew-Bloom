tsAppLink(item);\n33: \n34:     if (el.tagName === \"A\") {\n35:       el.href = link;\n36:       el.target = \"_blank\";\n37:       el.rel = \"noopener noreferrer\";\n38:     } else if (el.tagName === \"BUTTON\") {\n39:       el.addEventListener(\"click\", () => {\n40:         window.open(link, \"_blank\", \"noopener,noreferrer\");\n41:       });\n42:     }\n43:   });\n44: }\n45: \n46: \n47: /* ══════════════════════════════════════════════════════════\n48:    STICKY NAVBAR\n49:    Adds .scrolled class when page scrolls past the hero.\n50:    ══════════════════════════════════════════════════════════ */\n51: function initNavbar() {\n52:   const navbar = document.getElementById(\"navbar\");\n53:   if (!navbar) return;\n54: \n55:   const onScroll = () => {\n56:     navbar.classList.toggle(\"scrolled\", window.scrollY > 60);\n57:   };\n58: \n59:   window.addEventListener(\"scroll\", onScroll, { passive: true });\n60:   onScroll(); // run once on load\n61: }\n62: \n63: \n64: /* ══════════════════════════════════════════════════════════\n65:    ACTIVE NAV LINK  (IntersectionObserver)\n66:    ══════════════════════════════════════════════════════════ */\n67: function initActiveNavLinks() {\n68:   const sections = document.querySelectorAll(\"section[id], .hero[id]\");\n69:   const navLinks = document.querySelectorAll(\".nav-link\");\n70:   if (!sections.length || !navLinks.length) return;\n71: \n72:   const observer = new IntersectionObserver(\n73:     (entries) => {\n74:       entries.forEach((entry) => {\n75:         if (entry.isIntersecting) {\n76:           const id = entry.target.id;\n77:           navLinks.forEach((link) => {\n78:             const href = link.getAttribute(\"href\");\n79:             link.classList.toggle(\"active\", href === `#${id}`);\n80:           });\n81:         }\n82:       });\n83:     },\n84:     { rootMargin: \"-40% 0px -55% 0px\" }\n85:   );\n86: \n87:   sections.forEach((s) => observer.observe(s));\n88: }\n89: \n90: \n91: /* ══════════════════════════════════════════════════════════\n92:    HAMBURGER MOBILE MENU\n93:    ══════════════════════════════════════════════════════════ */\n94: function initHamburger() {\n95:   const btn   = document.getElementById(\"hamburger\");\n96:   const links = document.getElementById(\"navLinks\");\n97:   if (!btn || !links) return;\n98: \n99:   const close = () => {\n100:     btn.classList.remove(\"open\");\n101:     links.classList.remove(\"open\");\n102:     btn.setAttribute(\"aria-expanded\", \"false\");\n103:   };\n104: \n105:   btn.addEventListener(\"click\", () => {\n106:     const isOpen = btn.classList.toggle(\"open\");\n107:     links.classList.toggle(\"open\", isOpen);\n108:     btn.setAttribute(\"aria-expanded\", String(isOpen));\n109:   });\n110: \n111:   // Close on nav link click\n112:   links.querySelectorAll(\".nav-link\").forEach((link) => {\n113:     link.addEventListener(\"click\", close);\n114:   });\n115: \n116:   // Close on outside click\n117:   document.addEventListener(\"click\", (e) => {\n118:     if (!btn.contains(e.target) && !links.contains(e.target)) close();\n119:   });\n120: \n121:   // Close on Escape\n122:   document.addEventListener(\"keydown\", (e) => {\n123:     if (e.key === \"Escape\") close();\n124:   });\n125: }\n126: \n127: \n128: /* ══════════════════════════════════════════════════════════\n129:    MENU CATEGORY TABS\n130:    ══════════════════════════════════════════════════════════ */\n131: function initMenuTabs() {\n132:   const tabs   = document.querySelectorAll(\".tab-btn\");\n133:   const panels = document.querySelectorAll(\".tab-panel\");\n134: \n135:   tabs.forEach((tab) => {\n136:     tab.addEventListener(\"click\", () => {\n137:       const target = tab.dataset.tab;\n138: \n139:       // Update tab buttons\n140:       tabs.forEach((t) => {\n141:         t.classList.toggle(\"active\", t === tab);\n142:         t.setAttribute(\"aria-selected\", t === tab ? \"true\" : \"false\");\n143:       });\n144: \n145:       // Show/hide panels\n146:       panels.forEach((panel) => {\n147:         const isActive = panel.id === `tab-${target}`;\n148:         panel.classList.toggle(\"active\", isActive);\n149:         if (isActive) {\n150:           panel.removeAttribute(\"hidden\");\n151:         } else {\n152:           panel.setAttribute(\"hidden\", \"\");\n153:         }\n154:       });\n155:     });\n156:   });\n157: }\n158: \n159: \n160: /* ══════════════════════════════════════════════════════════\n161:    SCROLL REVEAL  (IntersectionObserver)\n162:    ══════════════════════════════════════════════════════════ */\n163: function initScrollReveal() {\n164:   // Assign .reveal to main content blocks\n165:   const revealSelectors = [\n166:     \".menu-card\",\n167:     \".bestseller-card\",\n168:     \".info-card\",\n169:     \".about-values .value-item\",\n170:     \".gallery-item\",\n171:     \".contact-item\",\n172:     \".about-content\",\n173:   ];\n174: \n175:   revealSelectors.forEach((sel) => {\n176:     document.querySelectorAll(sel).forEach((el, i) => {\n177:       el.classList.add(\"reveal\");\n178:       el.style.transitionDelay = `${i * 60}ms`;\n179:     });\n180:   });\n181: \n182:   // Section headers\n183:   document.querySelectorAll(\".section-header, .about-imagery\").forEach((el) => {\n184:     el.classList.add(\"reveal\");\n185:   });\n186: \n187:   const observer = new IntersectionObserver(\n188:     (entries) => {\n189:       entries.forEach((entry) => {\n190:         if (entry.isIntersecting) {\n191:           entry.target.classList.add(\"visible\");\n192:           observer.unobserve(entry.target);\n193:         }\n194:       });\n195:     },\n196:     { threshold: 0.12 }\n197:   );\n198: \n199:   document.querySelectorAll(\".reveal\").forEach((el) => observer.observe(el));\n200: }\n201: \n202: \n203: /* ══════════════════════════════════════════════════════════\n204:    BACK TO TOP BUTTON\n205:    ══════════════════════════════════════════════════════════ */\n206: function initBackToTop() {\n207:   const btn = document.getElementById(\"backToTop\");\n208:   if (!btn) return;\n209: \n210:   window.addEventListener(\n211:     \"scroll\",\n212:     () => {\n213:       btn.classList.toggle(\"visible\", window.scrollY > 500);\n214:     },\n215:     { passive: true }\n216:   );\n217: \n218:   btn.addEventListener(\"click\", () => {\n219:     window.scrollTo({ top: 0, behavior: \"smooth\" });\n220:   });\n221: }\n222: \n223: \n224: /* ══════════════════════════════════════════════════════════\n225:    SMOOTH SCROLL for anchor links (fallback for older browsers)\n226:    ══════════════════════════════════════════════════════════ */\n227: function initSmoothScroll() {\n228:   document.querySelectorAll('a[href^=\"#\"]').forEach((anchor) => {\n229:     anchor.addEventListener(\"click\", (e) => {\n230:       const targetId = anchor.getAttribute(\"href\");\n231:       if (targetId === \"#\") return;\n232:       const target = document.querySelector(targetId);\n233:       if (!target) return;\n234:       e.preventDefault();\n235:       target.scrollIntoView({ behavior: \"smooth\", block: \"start\" });\n236:     });\n237:   });\n238: }\n239: \n240: \n241: /* ══════════════════════════════════════════════════════════\n242:    GALLERY KEYBOARD ACCESS\n243:    ══════════════════════════════════════════════════════════ */\n244: function initGalleryA11y() {\n245:   document.querySelectorAll(\".gallery-item[tabindex]\").forEach((item) => {\n246:     item.addEventListener(\"keydown\", (e) => {\n247:       if (e.key === \"Enter\" || e.key === \" \") {\n248:         e.preventDefault();\n249:         // Toggle overlay visibility via focus (handled in CSS)\n250:         item.focus();\n251:       }\n252:     });\n253:   });\n254: }\n255: \n256: \n257: /* ══════════════════════════════════════════════════════════\n258:    HERO PARALLAX  (subtle, only on desktop)\n259:    ══════════�
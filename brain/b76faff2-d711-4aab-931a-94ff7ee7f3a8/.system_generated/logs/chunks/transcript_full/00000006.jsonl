lementById('upiQrCodeImg');\n510: \n511:   if (upiVpaDisplay) upiVpaDisplay.textContent = CONFIG.payment.upiId || 'brewbloom@upi';\n512: \n513:   document.querySelectorAll('input[name=\"paymentMethod\"]').forEach((input) => {\n514:     input.addEventListener('change', () => {\n515:       document.querySelectorAll('.payment-card-option').forEach((card) => card.classList.remove('active'));\n516:       input.closest('.payment-card-option').classList.add('active');\n517: \n518:       if (input.value === 'upi' && upiBox) {\n519:         upiBox.style.display = 'block';\n520:         const snapshot = getSnapshot(state.deliveryMode === 'delivery' ? state.customerDistanceKm : 0);\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

{"step_index":191,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-30T21:59:24Z","content":"Created At: 2026-10-01T03:29:24+05:30\nCompleted At: 2026-10-01T03:29:25+05:30\nFile Path: `file:///C:/Users/Lenovo/.gemini/antigravity/scratch/brew-and-bloom/script.js`\nTotal Lines: 880\nTotal Bytes: 34057\nShowing lines 660 to 790\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n660:    ══════════════════════════════════════════════════════════ */\n661: async function handleOrderSubmit(e) {\n662:   e.preventDefault();\n663: \n664:   const nameInput = document.getElementById('custName');\n665:   const phoneInput = document.getElementById('custPhone');\n666:   const addrInput = document.getElementById('custAddress');\n667:   const localInput = document.getElementById('custLocality');\n668:   const pinInput = document.getElementById('custPin');\n669:   const notesInput = document.getElementById('custNotes');\n670:   const paymentMethod = document.querySelector('input[name=\"paymentMethod\"]:checked')?.value || 'cod';\n671: \n672:   // Validation\n673:   let isValid = true;\n674: \n675:   if (!nameInput.value.trim()) {\n676:     nameInput.classList.add('invalid');\n677:     isValid = false;\n678:   } else {\n679:     nameInput.classList.remove('invalid');\n680:   }\n681: \n682:   // Indian mobile validation (10 digits starting with 6-9)\n683:   const phoneVal = phoneInput.value.trim().replace(/\\D/g, '');\n684:   if (!/^[6-9]\\d{9}$/.test(phoneVal)) {\n685:     phoneInput.classList.add('invalid');\n686:     isValid = false;\n687:   } else {\n688:     phoneInput.classList.remove('invalid');\n689:   }\n690: \n691:   if (state.deliveryMode === 'delivery') {\n692:     if (!addrInput.value.trim()) {\n693:       addrInput.classList.add('invalid');\n694:       isValid = false;\n695:     } else {\n696:       addrInput.classList.remove('invalid');\n697:     }\n698: \n699:     if (!localInput.value.trim()) {\n700:       localInput.classList.add('invalid');\n701:       isValid = false;\n702:     } else {\n703:       localInput.classList.remove('invalid');\n704:     }\n705: \n706:     if (!/^\\d{6}$/.test(pinInput.value.trim())) {\n707:       pinInput.classList.add('invalid');\n708:       isValid = false;\n709:     } else {\n710:       pinInput.classList.remove('invalid');\n711:     }\n712: \n713:     if (state.customerDistanceKm > CONFIG.delivery.radiusKm) {\n714:       showToast(`Delivery is only available within ${CONFIG.delivery.radiusKm} km. Please select Takeaway or Dine-in.`, 'error');\n715:       return;\n716:     }\n717:   }\n718: \n719:   if (!isValid) {\n720:     showToast('Please fix the errors highlighted in red.', 'error');\n721:     return;\n722:   }\n723: \n724:   const snapshot = getSnapshot(state.deliveryMode === 'delivery' ? state.customerDistanceKm : 0);\n725: \n726:   if (snapshot.items.length === 0) {\n727:     showToast('Your cart is empty!', 'error');\n728:     return;\n729:   }\n730: \n731:   const confirmBtn = document.getElementById('confirmOrderBtn');\n732:   if (confirmBtn) {\n733:     confirmBtn.disabled = true;\n734:     confirmBtn.textContent = 'Processing your order...';\n735:   }\n736: \n737:   const orderData = {\n738:     customer_name: nameInput.value.trim(),\n739:     customer_phone: phoneVal,\n740:     order_mode: state.deliveryMode,\n741:     delivery_address: state.deliveryMode === 'delivery'\n742:       ? `${addrInput.value.trim()}, ${localInput.value.trim()}, Haldia - ${pinInput.value.trim()}`\n743:       : 'Self Pickup / Dine-in at Haldia Café',\n744:     customer_lat: state.customerLat,\n745:     customer_lng: state.customerLng,\n746:     customer_distance_km: state.deliveryMode === 'delivery' ? state.customerDistanceKm : 0,\n747:     special_instructions: notesInput?.value.trim() || '',\n748:     payment_method: paymentMethod,\n749:     subtotal: snapshot.subtotal,\n750:     tax_amount: snapshot.gstAmount,\n751:     delivery_charge: state.deliveryMode === 'delivery' ? snapshot.deliveryCharge : 0,\n752:     total_amount: state.deliveryMode === 'delivery' ? snapshot.total : snapshot.subtotal + snapshot.gstAmount,\n753:     items: snapshot.items,\n754:     status: 'received',\n755:   };\n756: \n757:   try {\n758:     const createdOrder = await placeOrder(orderData);\n759:     clearCart();\n760:     closeCheckoutModal();\n761: \n762:     showToast(`Order #${createdOrder.id} placed successfully!`, 'success');\n763: \n764:     // Forward to dedicated Live Order Tracking page!\n765:     setTimeout(() => {\n766:       window.location.href = `order-tracking.html?orderId=${createdOrder.id}`;\n767:     }, 1200);\n768:   } catch (err) {\n769:     console.error('Order error:', err);\n770:     showToast('Could not record order: ' + (err.message || 'Unknown error'), 'error');\n771:     if (confirmBtn) {\n772:       confirmBtn.disabled = false;\n773:       confirmBtn.textContent = 'Place Order Now →';\n774:     }\n775:   }\n776: }\n777: \n778: /* ══════════════════════════════════════════════════════════\n779:    HALDIA CAFÉ LOCATION MAP (Section)\n780:    ══════════════════════════════════════════════════════════ */\n781: function initLocationMap() {\n782:   const mapEl = document.getElementById('locationLeafletMap');\n783:   if (!mapEl || typeof L === 'undefined') return;\n784: \n785:   const lat = CONFIG.restaurant.lat;\n786:   const lng = CONFIG.restaurant.lng;\n787: \n788:   const map = L.map('locationLeafletMap', { scrollWheelZoom: false }).setView([lat, lng], 14);\n789: \n790:   L.tileLayer(CONFIG.map.tileUrl, {\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

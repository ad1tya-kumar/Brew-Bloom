{"step_index":203,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-30T22:00:30Z","content":"Created At: 2026-10-01T03:30:30+05:30\nCompleted At: 2026-10-01T03:30:31+05:30\nFile Path: `file:///C:/Users/Lenovo/.gemini/antigravity/scratch/brew-and-bloom/script.js`\nTotal Lines: 880\nTotal Bytes: 34089\nShowing lines 395 to 540\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n395:    CHECKOUT MODAL & LOCATION LEAFLET ENGINE\n396:    ══════════════════════════════════════════════════════════ */\n397: function openCheckoutModal() {\n398:   const modal = document.getElementById('checkoutModalBackdrop');\n399:   if (!modal) return;\n400:   modal.classList.add('active');\n401:   document.body.style.overflow = 'hidden';\n402: \n403:   updateCheckoutSummary();\n404:   initCheckoutMap();\n405: }\n406: \n407: function closeCheckoutModal() {\n408:   const modal = document.getElementById('checkoutModalBackdrop');\n409:   if (!modal) return;\n410:   modal.classList.remove('active');\n411:   document.body.style.overflow = '';\n412: }\n413: \n414: function updateCheckoutSummary() {\n415:   const dist = state.deliveryMode === 'delivery' ? state.customerDistanceKm : 0;\n416:   const snapshot = getSnapshot(dist);\n417: \n418:   const subtotalEl = document.getElementById('chkSummarySubtotal');\n419:   const taxEl = document.getElementById('chkSummaryTax');\n420:   const deliveryEl = document.getElementById('chkSummaryDelivery');\n421:   const totalEl = document.getElementById('chkSummaryTotal');\n422: \n423:   if (subtotalEl) subtotalEl.textContent = `₹${snapshot.subtotal}`;\n424:   if (taxEl) taxEl.textContent = `₹${snapshot.gstAmount}`;\n425: \n426:   if (deliveryEl) {\n427:     if (state.deliveryMode !== 'delivery') {\n428:       deliveryEl.textContent = '₹0 (Self/Dine-in)';\n429:     } else {\n430:       deliveryEl.textContent = snapshot.deliveryCharge === 0 ? 'FREE' : `₹${snapshot.deliveryCharge}`;\n431:     }\n432:   }\n433: \n434:   const finalTotal = state.deliveryMode === 'delivery'\n435:     ? snapshot.total\n436:     : snapshot.subtotal + snapshot.gstAmount;\n437: \n438:   if (totalEl) totalEl.textContent = `₹${finalTotal}`;\n439: }\n440: \n441: function initCheckoutWorkflow() {\n442:   const closeBtn = document.getElementById('closeCheckoutBtn');\n443:   const backdrop = document.getElementById('checkoutModalBackdrop');\n444:   if (closeBtn) closeBtn.addEventListener('click', closeCheckoutModal);\n445: \n446:   // Delivery mode switcher\n447:   document.querySelectorAll('.mode-btn').forEach((btn) => {\n448:     btn.addEventListener('click', () => {\n449:       document.querySelectorAll('.mode-btn').forEach((b) => b.classList.remove('active'));\n450:       btn.classList.add('active');\n451:       state.deliveryMode = btn.dataset.mode;\n452: \n453:       const mapContainer = document.getElementById('checkoutMapContainer');\n454:       const distBadge = document.getElementById('mapDistanceBadge');\n455:       const locRow = document.getElementById('locationPickerRow');\n456:       const addrGroup = document.getElementById('addressFieldGroup');\n457:       const locGroup = document.getElementById('localityFieldGroup');\n458:       const pinGroup = document.getElementById('pincodeFieldGroup');\n459: \n460:       if (state.deliveryMode !== 'delivery') {\n461:         if (mapContainer) mapContainer.style.display = 'none';\n462:         if (distBadge) distBadge.style.display = 'none';\n463:         if (locRow) locRow.style.display = 'none';\n464:         if (addrGroup) addrGroup.style.display = 'none';\n465:         if (locGroup) locGroup.style.display = 'none';\n466:         if (pinGroup) pinGroup.style.display = 'none';\n467:       } else {\n468:         if (mapContainer) mapContainer.style.display = 'block';\n469:         if (distBadge) distBadge.style.display = 'flex';\n470:         if (locRow) locRow.style.display = 'flex';\n471:         if (addrGroup) addrGroup.style.display = 'block';\n472:         if (locGroup) locGroup.style.display = 'block';\n473:         if (pinGroup) pinGroup.style.display = 'block';\n474:         if (state.checkoutMap) state.checkoutMap.invalidateSize();\n475:       }\n476: \n477:       updateCheckoutSummary();\n478:     });\n479:   });\n480: \n481:   // Geolocation trigger\n482:   const btnGeo = document.getElementById('btnUseGeolocation');\n483:   if (btnGeo) {\n484:     btnGeo.addEventListener('click', () => {\n485:       if (!navigator.geolocation) {\n486:         showToast('Geolocation is not supported by your browser.', 'error');\n487:         return;\n488:       }\n489:       showToast('Requesting GPS location...', 'info');\n490:       navigator.geolocation.getCurrentPosition(\n491:         (pos) => {\n492:           state.customerLat = pos.coords.latitude;\n493:           state.customerLng = pos.coords.longitude;\n494:           updateCheckoutLocation(state.customerLat, state.customerLng, 'GPS Location Detected');\n495:           showToast('GPS location updated!', 'success');\n496:         },\n497:         (err) => {\n498:           showToast('Could not get GPS location. Please enter your address manually.', 'error');\n499:         },\n500:         { enableHighAccuracy: true, timeout: 8000 }\n501:       );\n502:     });\n503:   }\n504: \n505:   // Payment radio card styling & dynamic UPI details\n506:   const upiBox = document.getElementById('upiPaymentDetailsBox');\n507:   const upiVpaDisplay = document.getElementById('upiVpaDisplay');\n508:   const upiDeepBtn = document.getElementById('btnUpiDeepLink');\n509:   const upiQrImg = document.getElementById('upiQrCodeImg');\n510: \n511:   if (upiVpaDisplay) upiVpaDisplay.textContent = CONFIG.payment.upiId || 'brewbloom@upi';\n512: \n513:   document.querySelectorAll('input[name=\"paymentMethod\"]').forEach((input) => {\n514:     input.addEventListener('change', () => {\n515:       document.querySelectorAll('.payment-card-option').forEach((card) => card.classList.remove('active'));\n516:       input.closest('.payment-card-option').classList.add('active');\n517: \n518:       if (input.value === 'upi' && upiBox) {\n519:         upiBox.style.display = 'block';\n520:         const snapshot = getSnapshot(state.deliveryMode === 'delivery' ? state.customerDistanceKm : 0);\n521:         const finalTotal = state.deliveryMode === 'delivery'\n522:           ? snapshot.total\n523:           : snapshot.subtotal + snapshot.gstAmount;\n524:         \n525:         const upiUri = `upi://pay?pa=${encodeURIComponent(CONFIG.payment.upiId || 'brewbloom@upi')}&pn=${encodeURIComponent(CONFIG.payment.upiName || 'Brew & Bloom Cafe')}&am=${finalTotal}&cu=INR`;\n526:         if (upiDeepBtn) upiDeepBtn.href = upiUri;\n527:         if (upiQrImg) upiQrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=110x110&data=${encodeURIComponent(upiUri)}`;\n528:       } else if (upiBox) {\n529:         upiBox.style.display = 'none';\n530:       }\n531:     });\n532:   });\n533: \n534:   // Form submission\n535:   const form = document.getElementById('checkoutForm');\n536:   if (form) {\n537:     form.addEventListener('submit', handleOrderSubmit);\n538:   }\n539: }\n540: \nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

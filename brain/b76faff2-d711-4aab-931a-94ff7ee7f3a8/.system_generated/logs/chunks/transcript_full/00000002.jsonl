hadow-lg:   0 16px 48px rgba(59,31,14,.16);\n38:   --nav-h:       72px;\n39:   --transition:  0.3s cubic-bezier(0.4,0,0.2,1);\n40: }\n41: \n42: html {\n43:   scroll-behavior: smooth;\n44:   scroll-padding-top: var(--nav-h);\n45:   font-size: 16px;\n46:   -webkit-text-size-adjust: 100%;\n47: }\n48: \n49: body {\n50:   font-family: 'Inter', sans-serif;\n51:   background: var(--cream);\n52:   color: var(--text);\n53:   line-height: 1.65;\n54:   overflow-x: hidden;\n55: }\n56: \n57: img { max-width: 100%; display: block; }\n58: a { color: inherit; text-decoration: none; }\n59: button { cursor: pointer; font-family: inherit; border: none; background: none; }\n60: ul { list-style: none; }\n61: address { font-style: normal; }\n62: \n63: /* ── TYPOGRAPHY ────────────────────────────────────────── */\n64: h1, h2, h3, h4, h5 {\n65:   font-family: 'Playfair Display', serif;\n66:   line-height: 1.25;\n67:   color: var(--espresso);\n68: }\n69: \n70: .section-eyebrow {\n71:   font-family: 'Dancing Script', cursive;\n72:   font-size: 1.25rem;\n73:   color: var(--caramel);\n74:   display: block;\n75:   margin-bottom: 0.4rem;\n76: }\n77: \n78: .section-title {\n79:   font-size: clamp(2rem, 4vw, 2.8rem);\n80:   font-weight: 700;\n81:   margin-bottom: 1rem;\n82: }\n83: \n84: .section-desc {\n85:   color: var(--text-muted);\n86:   max-width: 56ch;\n87:   margin: 0 auto;\n88: }\n89: \n90: .section-header {\n91:   text-align: center;\n92:   margin-bottom: 3rem;\n93: }\n94: \n95: /* ── CONTAINER ─────────────────────────────────────────── */\n96: .container {\n97:   max-width: 1200px;\n98:   margin: 0 auto;\n99:   padding: 0 1.5rem;\n100: }\n101: \n102: /* ── SECTION ───────────────────────────────────────────── */\n103: .section {\n104:   padding: 5rem 0;\n105: }\n106: \n107: /* ── BUTTONS ───────────────────────────────────────────── */\n108: .btn {\n109:   display: inline-flex;\n110:   align-items: center;\n111:   justify-content: center;\n112:   gap: 0.5rem;\n113:   padding: 0.7rem 1.6rem;\n114:   border-radius: 100px;\n115:   font-weight: 600;\n116:   font-size: 0.925rem;\n117:   letter-spacing: 0.02em;\n118:   transition: all var(--transition);\n119:   white-space: nowrap;\n120:   cursor: pointer;\n121:   border: 2px solid transparent;\n122: }\n123: \n124: .btn-lg {\n125:   padding: 0.9rem 2rem;\n126:   font-size: 1rem;\n127: }\n128: \n129: .btn-sm {\n130:   padding: 0.45rem 1.1rem;\n131:   font-size: 0.8rem;\n132: }\n133: \n134: .btn-primary {\n135:   background: var(--espresso);\n136:   color: var(--cream);\n137:   border-color: var(--espresso);\n138: }\n139: .btn-primary:hover, .btn-primary:focus-visible {\n140:   background: var(--caramel);\n141:   border-color: var(--caramel);\n142:   transform: translateY(-2px);\n143:   box-shadow: 0 8px 24px rgba(196,114,30,.35);\n144: }\n145: \n146: .btn-ghost {\n147:   background: rgba(255,255,255,0.12);\n148:   color: var(--white);\n149:   border-color: rgba(255,255,255,0.5);\n150:   backdrop-filter: blur(8px);\n151: }\n152: .btn-ghost:hover, .btn-ghost:focus-visible {\n153:   background: rgba(255,255,255,0.22);\n154:   border-color: rgba(255,255,255,0.9);\n155:   transform: translateY(-2px);\n156: }\n157: \n158: .btn-whatsapp {\n159:   background: #25D366;\n160:   color: #fff;\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

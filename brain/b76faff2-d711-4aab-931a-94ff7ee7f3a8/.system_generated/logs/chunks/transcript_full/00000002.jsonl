�═══════════════════════════════════════════════ */\n260: function initHeroParallax() {\n261:   const heroBg = document.querySelector(\".hero-bg\");\n262:   if (!heroBg) return;\n263: \n264:   let ticking = false;\n265: \n266:   const onScroll = () => {\n267:     if (!ticking) {\n268:       requestAnimationFrame(() => {\n269:         if (window.scrollY < window.innerHeight) {\n270:           const offset = window.scrollY * 0.25;\n271:           heroBg.style.transform = `scale(1.05) translateY(${offset}px)`;\n272:         }\n273:         ticking = false;\n274:       });\n275:       ticking = true;\n276:     }\n277:   };\n278: \n279:   // Only on desktop (avoid jank on mobile)\n280:   if (window.innerWidth > 900) {\n281:     window.addEventListener(\"scroll\", onScroll, { passive: true });\n282:   }\n283: }\n284: \n285: \n286: /* ══════════════════════════════════════════════════════════\n287:    INIT — run after DOM is ready\n288:    ══════════════════════════════════════════════════════════ */\n289: document.addEventListener(\"DOMContentLoaded\", () => {\n290:   initWhatsAppLinks();\n291:   initNavbar();\n292:   initActiveNavLinks();\n293:   initHamburger();\n294:   initMenuTabs();\n295:   initScrollReveal();\n296:   initBackToTop();\n297:   initSmoothScroll();\n298:   initGalleryA11y();\n299:   initHeroParallax();\n300: \n301:   console.log(\n302:     \"%c☕ Brew & Bloom Café\",\n303:     \"font-size:20px;color:#c4721e;font-weight:bold\"\n304:   );\n305:   console.log(\n306:     \"%cTo customise WhatsApp number, edit WHATSAPP_NUMBER in script.js\",\n307:     \"color:#8b5a2b\"\n308:   );\n309: });\n310: \nThe above content shows the entire, complete file contents of the requested file.\n"}

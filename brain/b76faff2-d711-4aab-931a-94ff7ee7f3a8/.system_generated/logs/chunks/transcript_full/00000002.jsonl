near-gradient(135deg,#7b0000 0%,#c0392b 50%,#f1948a 100%)', icon: '🍕' },\n26:   desserts: { gradient: 'linear-gradient(135deg,#2c003e 0%,#6c3483 50%,#f8c8e4 100%)', icon: '🍰' },\n27: };\n28: \n29: /**\n30:  * MENU ITEMS\n31:  * Each item:\n32:  *   id          – unique slug\n33:  *   name        – display name\n34:  *   category    – must match a CATEGORIES id\n35:  *   price       – number (₹)\n36:  *   description – short tagline\n37:  *   tags        – array: 'bestseller' | 'veg' | 'new' | 'spicy'\n38:  *   emoji       – representative emoji (used when no photo)\n39:  *   gradient    – CSS gradient for the card background\n40:  *   available   – boolean (false = out of stock)\n41:  */\n42: export const MENU_ITEMS = [\n43: \n44:   // ── COFFEE ─────────────────────────────────────────────\n45:   {\n46:     id: 'espresso',\n47:     name: 'Espresso',\n48:     category: 'coffee',\n49:     price: 80,\n50:     description: 'Rich, bold single-origin shot with a velvety crema',\n51:     tags: ['veg'],\n52:     emoji: '☕',\n53:     gradient: 'linear-gradient(135deg,#3b1f0e,#6b3a1f)',\n54:     available: true,\n55:   },\n56:   {\n57:     id: 'cappuccino',\n58:     name: 'Cappuccino',\n59:     category: 'coffee',\n60:     price: 120,\nThe above content does NOT show the entire file contents. If you need to view any lines of the file which were not shown to complete your task, call this tool again to view those lines.\n"}

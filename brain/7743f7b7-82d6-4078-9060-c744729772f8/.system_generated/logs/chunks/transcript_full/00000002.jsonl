g-slate);\n  color: var(--text-body);\n  line-height: 1.6;\n  overflow-x: hidden;\n  -webkit-font-smoothing: antialiased;\n}\n\n/* Indic Script Font Classes */\n.indic-text, .script-text {\n  font-family: var(--font-indic);\n}\n\n/* Tribal Sohrai/Khovar Background Motif */\n.tribal-pattern-bg {\n  background-image: \n    radial-gradient(var(--border-subtle) 1px, transparent 1px),\n    linear-gradient(to right, rgba(255, 103, 31, 0.02) 1px, transparent 1px);\n  background-size: 24px 24px, 48px 48px;\n}\n\n.tribal-border-top {\n  position: relative;\n}\n.tribal-border-top::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 6px;\n  background: repeating-linear-gradient(\n    45deg,\n    var(--accent-saffron),\n    var(--accent-saffron) 10px,\n    var(--bg-white) 10px,\n    var(--bg-white) 14px,\n    var(--accent-green) 14px,\n    var(--accent-green) 24px,\n    var(--primary-navy) 24px,\n    var(--primary-navy) 34px\n  );\n}\n\n/* Container */\n.container {\n  width: 100%;\n  max-width: 1240px;\n  margin: 0 auto;\n  padding: 0 24px;\n}\n\n/* Typography & Section Titles */\n.section-tag {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 0.82rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1.2px;\n  color: var(--accent-saffron);\n  background-color: var(--accent-saffron-light);\n  padding: 6px 14px;\n  border-radius: var(--radius-full);\n  margin-bottom: 14px;\n  border: 1px solid rgba(255, 103, 31, 0.2);\n}\n\n.section-tag.green {\n  color: var(--accent-green);\n  background-color: var(--accent-green-light);\n  border-color: rgba(4, 120, 87, 0.2);\n}\n\n.section-tag.navy {\n  color: var(--primary-navy);\n  background-color: rgba(10, 37, 64, 0.06);\n  border-color: rgba(10, 37, 64, 0.15);\n}\n\n.section-title {\n  font-size: 2.35rem;\n  font-weight: 800;\n  color: var(--primary-navy);\n  line-height: 1.25;\n  letter-spacing: -0.5px;\n  margin-bottom: 12px;\n}\n\n.section-subtitle {\n  font-size: 1.125rem;\n  color: var(--text-muted);\n  max-width: 720px;\n  margin-bottom: 40px;\n}\n\n.text-center {\n  text-align: center;\n}\n.text-center .section-subtitle {\n  margin-left: auto;\n  margin-right: auto;\n}\n\n/* ==========================================================================\n   Navbar\n   ========================================================================== */\n.navbar {\n  position: sticky;\n  top: 0;\n  z-index: 1000;\n  background: rgba(255, 255, 255, 0.92);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  border-bottom: 1px solid var(--border-subtle);\n  transition: all var(--transition-fast);\n}\n\n.navbar.scrolled {\n  box-shadow: var(--shadow-sm);\n  background: rgba(255, 255, 255, 0.98);\n}\n\n.nav-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  height: 72px;\n}\n\n.brand-logo {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  text-decoration: none;\n}\n\n.brand-symbol {\n  width: 44px;\n  height: 44px;\n  border-radius: 12px;\n  background: linear-gradient(135deg, var(--primary-navy) 0%, #173860 100%);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #fff;\n  font-size: 22px;\n  box-shadow: 0 4px 10px rgba(10, 37, 64, 0.25);\n  border: 1px solid rgba(255, 255, 255, 0.2);\n}\n\n.brand-text {\n  display: flex;\n  flex-direction: column;\n}\n\n.brand-name {\n  font-size: 1.25rem;\n  font-weight: 800;\n  color: var(--primary-navy);\n  letter-spacing: -0.3px;\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.brand-name .ai-badge {\n  font-size: 0.68rem;\n  padding: 2px 6px;\n  background: linear-gradient(90deg, var(--accent-saffron), #FF8533);\n  color: #fff;\n  border-radius: 4px;\n  font-weight: 700;\n}\n\n.brand-sub {\n  font-size: 0.7rem;\n  color: var(--text-muted);\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n.nav-links {\n  display: flex;\n  align-items: c
round: none;\n  border: none;\n  font-size: 1.6rem;\n  color: var(--primary-navy);\n  cursor: pointer;\n}\n\n/* ==========================================================================\n   Hero Section\n   ========================================================================== */\n.hero-section {\n  position: relative;\n  padding: 64px 0 40px;\n  background: linear-gradient(180deg, #FFFFFF 0%, #F1F5F9 100%);\n  overflow: hidden;\n}\n\n.hero-govt-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  background: #FFFFFF;\n  padding: 8px 18px;\n  border-radius: var(--radius-full);\n  border: 1.5px solid rgba(10, 37, 64, 0.12);\n  box-shadow: var(--shadow-sm);\n  margin-bottom: 24px;\n}\n\n.govt-emblem {\n  width: 22px;\n  height: 22px;\n  border-radius: 50%;\n  background: var(--accent-green);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #fff;\n  font-size: 11px;\n  font-weight: 900;\n}\n\n.govt-text {\n  font-size: 0.85rem;\n  font-weight: 700;\n  color: var(--primary-navy);\n}\n\n.hero-grid {\n  display: grid;\n  grid-template-columns: 1.15fr 0.85fr;\n  gap: 48px;\n  align-items: center;\n}\n\n.hero-content h1 {\n  font-size: 3.4rem;\n  font-weight: 900;\n  color: var(--primary-navy);\n  line-height: 1.12;\n  letter-spacing: -1.2px;\n  margin-bottom: 12px;\n}\n\n.hero-content .highlight {\n  background: linear-gradient(120deg, var(--accent-saffron), #FF8A00);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n\n.hero-tagline {\n  font-size: 1.45rem;\n  font-weight: 700;\n  color: var(--accent-green);\n  margin-bottom: 18px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.hero-desc {\n  font-size: 1.15rem;\n  color: var(--text-body);\n  line-height: 1.7;\n  margin-bottom: 28px;\n  max-width: 620px;\n}\n\n.hero-alt-names {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-bottom: 32px;\n}\n\n.alt-label {\n  font-size: 0.8rem;\n  font-
enter;\n  padding: 30px;\n  text-align: center;\n}\n\n.video-play-btn {\n  width: 80px;\n  height: 80px;\n  border-radius: 50%;\n  background: var(--accent-saffron);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #fff;\n  font-size: 32px;\n  box-shadow: 0 0 0 12px rgba(255, 103, 31, 0.25);\n  margin-bottom: 20px;\n  transition: all var(--transition-fast);\n}\n\n.video-player-frame:hover .video-play-btn {\n  transform: scale(1.1);\n  background: #FF7B3B;\n  box-shadow: 0 0 0 18px rgba(255, 103, 31, 0.35);\n}\n\n.video-title-overlay {\n  font-size: 1.45rem;\n  font-weight: 800;\n  color: #fff;\n  margin-bottom: 6px;\n}\n\n.video-subtitle-overlay {\n  font-size: 0.95rem;\n  color: #CBD5E1;\n}\n\n.video-meta-badges {\n  display: flex;\n  gap: 12px;\n  margin-top: 14px;\n}\n\n.video-chip {\n  padding: 4px 10px;\n  background: rgba(255, 255, 255, 0.15);\n  border-radius: 4px;\n  font-size: 0.75rem;\n  color: #fff;\n  font-weight: 600;\n}\n\n/* Video Chapters */\n.video-chapters-row {\n  max-width: 920px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 14px;\n}\n\n.chapter-btn {\n  padding: 12px;\n  background: var(--bg-slate);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-sm);\n  text-align: left;\n  cursor: pointer;\n  transition: all var(--transition-fast);\n}\n\n.chapter-btn:hover {\n  background: #FFFFFF;\n  border-color: var(--accent-saffron);\n}\n\n.chapter-time {\n  font-size: 0.75rem;\n  font-weight: 800;\n  color: var(--accent-saffron);\n  display: block;\n}\n\n.chapter-name {\n  font-size: 0.85rem;\n  font-weight: 700;\n  color: var(--primary-navy);\n}\n\n/* ==========================================================================\n   Team Section\n   ========================================================================== */\n.team-section {\n  padding: 88px 0;\n  background-color: var(--bg-slate);\n  border-bottom: 1px solid var(--border-subtle);\n}\n\n.team-
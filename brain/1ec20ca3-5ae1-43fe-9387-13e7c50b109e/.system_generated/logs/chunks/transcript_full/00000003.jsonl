={<FamilyPage />} />\n            <Route path={ROUTES.EMERGENCY_CARD} element={<EmergencyCardPage />} />\n            <Route path={ROUTES.REMINDERS} element={<RemindersPage />} />\n            <Route path=\"*\" element={<Navigate to={ROUTES.DASHBOARD} replace />} />\n          </Routes>\n        </main>\n        <footer className=\"bg-white border-t border-slate-200 py-6 text-center text-xs text-slate-500 no-print\">\n          <div className=\"max-w-6xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2\">\n            <p>\n              © 2026 <strong>LifeChart</strong> (लाइफचार्ट) • Layered on India's ABDM / ABHA Ecosystem\n            </p>\n            <p className=\"text-teal-700 font-medium\">\n              DPDP Act 2023 Compliant • End-to-End Encrypted • Zero Aadhaar Storage\n            </p>\n          </div>\n        </footer>\n      </div>\n    </BrowserRouter>\n  );\n};\n\nexport default App;\n","Description":"App component with router and page routes","Overwrite":true,"TargetFile":"C:\\Users\\Lenovo\\.gemini\\antigravity\\scratch\\lifechart\\src\\App.tsx","toolAction":"Creating App component","toolSummary":"Create App component"}}]}

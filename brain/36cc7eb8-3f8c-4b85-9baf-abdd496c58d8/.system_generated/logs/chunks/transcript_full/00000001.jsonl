{"step_index":73,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-09-25T18:40:48Z","content":"Created At: 2026-09-26T00:10:48+05:30\nCompleted At: 2026-09-26T00:10:49+05:30\nFile Path: `file:///C:/Users/Lenovo/.gemini/antigravity/scratch/lifechart/src/pages/DashboardPage.tsx`\nTotal Lines: 274\nTotal Bytes: 11851\nShowing lines 1 to 150\nThe following code has been modified to include a line number before every line, in the format: <line_number>: <original_line>. Please note that any changes targeting the original code should remove the line number, colon, and leading space.\n1: import React from 'react';\n2: import { useTranslation } from 'react-i18next';\n3: import { Link } from 'react-router-dom';\n4: import { ROUTES } from '../config/routes';\n5: import { useAppStore } from '../services/store';\n6: import { RecurringIllnessBanner, DPDPComplianceBadge } from '../components/common/AlertBanner';\n7: import {\n8:   Activity,\n9:   Calendar,\n10:   Camera,\n11:   FileText,\n12:   Share2,\n13:   Users,\n14:   AlertTriangle,\n15:   Bell,\n16:   Heart,\n17:   Droplet,\n18:   ShieldCheck,\n19:   ArrowRight,\n20:   Clock,\n21:   Sparkles,\n22:   Pill,\n23: } from 'lucide-react';\n24: \n25: export const DashboardPage: React.FC = () => {\n26:   const { t, i18n } = useTranslation();\n27:   const isHi = i18n.language === 'hi';\n28:   const { activePatientId, allProfiles, records, reminders, currentRole } = useAppStore();\n29: \n30:   const patient = allProfiles[activePatientId] || allProfiles['patient-rajesh'];\n31:   const recentRecords = records.slice(0, 3);\n32:   const activeReminders = reminders.filter((r) => r.is_active);\n33: \n34:   const quickActions = [\n35:     {\n36:       to: ROUTES.UPLOAD,\n37:       title: t('ocr.title'),\n38:       desc: 'Digitise handwritten doctor prescriptions & lab reports via OCR',\n39:       icon: Camera,\n40:       badge: 'Main Differentiator',\n41:       color: 'bg-teal-500',\n42:     },\n43:     {\n44:       to: ROUTES.TIMELINE,\n45:       title: t('timeline.title'),\n46:       desc: 'Chronological health events from 2004 to today with filters',\n47:       icon: Calendar,\n48:       badge: `${records.length} Records`,\n49:       color: 'bg-blue-600',\n50:     },\n51:     {\n52:       to: ROUTES.DOCTOR_SUMMARY,\n53:       title: t('doctor_summary.title'),\n54:       desc: 'Instant 60-second consultation screen: allergies, meds, outcomes',\n55:       icon: FileText,\n56:       badge: 'Single Screen',\n57:       color: 'bg-indigo-600',\n58:     },\n59:     {\n60:       to: ROUTES.SHARE_ACCESS,\n61:       title: t('consent.title'),\n62:       desc: 'Generate 24-hour clinic passcode & QR for your doctor (DPDP Act)',\n63:       icon: Share2,\n64:       badge: 'Time-Limited',\n65:       color: 'bg-teal-700',\n66:     },\n67:     {\n68:       to: ROUTES.EMERGENCY_CARD,\n69:       title: t('emergency.title'),\n70:       desc: 'Instant offline QR & wallet card with blood group & allergies',\n71:       icon: AlertTriangle,\n72:       badge: 'No Login Needed',\n73:       color: 'bg-rose-600',\n74:     },\n75:     {\n76:       to: ROUTES.FAMILY,\n77:       title: t('family.title'),\n78:       desc: 'Family profiles & Child Universal Immunization Programme (UIP)',\n79:       icon: Users,\n80:       badge: 'Pediatric UIP',\n81:       color: 'bg-amber-600',\n82:     },\n83:   ];\n84: \n85:   return (\n86:     <div className=\"max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8\">\n87:       {/* Patient Profile Hero Card */}\n88:       <div className=\"bg-gradient-to-r from-teal-900 via-teal-800 to-slate-900 text-white rounded-3xl p-6 sm:p-8 shadow-lg\">\n89:         <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6\">\n90:           <div className=\"flex items-start gap-5\">\n91:             <div className=\"w-18 h-18 rounded-2xl bg-white/10 border-2 border-teal-300 flex items-center justify-center text-white text-3xl font-black shrink-0\">\n92:              
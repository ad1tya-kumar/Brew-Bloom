{"step_index":39,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-09-23T18:34:58Z","content":"Now let me create all the type definitions:","tool_calls":[{"name":"write_to_file","args":{"CodeContent":"export type RecordType =\n  | 'prescription'\n  | 'lab_report'\n  | 'diagnosis'\n  | 'vaccination'\n  | 'discharge_summary'\n  | 'imaging'\n  | 'abdm_linked'\n  | 'other';\n\nexport type RecordSource = 'manual' | 'ocr' | 'abdm' | 'family';\n\nexport type Gender = 'male' | 'female' | 'other';\n\nexport type UserRole = 'patient' | 'doctor' | 'family_manager';\n\nexport type ConsentStatus = 'pending' | 'active' | 'expired' | 'revoked';\n\nexport type VaccinationStatus = 'pending' | 'done' | 'overdue' | 'skipped';\n\nexport type ReminderType = 'medicine' | 'follow_up' | 'vaccination' | 'custom';\n\nexport type AuditAction =\n  | 'view_record'\n  | 'view_summary'\n  | 'add_record'\n  | 'share_created'\n  | 'share_claimed'\n  | 'share_revoked'\n  | 'export_emergency_card';\n\nexport interface Profile {\n  id: string;\n  full_name: string;\n  full_name_hi?: string;\n  abha_number?: string;\n  abha_address?: string;\n  date_of_birth: string;\n  gender: Gender;\n  blood_group?: string;\n  phone?: string;\n  emergency_contact_name?: string;\n  emergency_contact_phone?: string;\n  known_allergies: string[];\n  chronic_conditions: string[];\n  preferred_language: 'en' | 'hi';\n  role: UserRole;\n  hpr_id?: string;\n  avatar_url?: string;\n  created_at: string;\n  updated_at: string;\n}\n\nexport interface HealthRecord {\n  id: string;\n  patient_id: string;\n  record_date: string;\n  record_type: RecordType;\n  title: string;\n  title_hi?: string;\n  doctor_name?: string;\n  hospital_name?: string;\n  diagnosis?: string;\n  diagnosis_hi?: string;\n  symptoms: string[];\n  notes?: string;\n  recovery_days?: number;\n  source: RecordSource;\n  abdm_record_id?: string;\n  is_verified: boolean;\n  medications?: Medication[];\n  attachments?: RecordAttachment[];\n  created_at: string;\n  updated_at: string;\n}\n\nexport interface Medication {\n  id: string;\n  record_id: string;\n  patient_id: string;\n  name: string;\n  name_hi?: string;\n  dosage?: string;\n  frequency?: string;\n  duration_days?: number;\n  is_current: boolean;\n  start_date?: string;\n  end_date?: string;\n  created_at: string;\n}\n\nexport interface RecordAttachment {\n  id: string;\n  record_id: string;\n  patient_id: string;\n  file_path: string;\n  file_type?: string;\n  file_size_bytes?: number;\n  ocr_raw_text?: string;\n  ocr_structured?: OCRStructuredData;\n  created_at: string;\n}\n\nexport interface OCRStructuredData {\n  doctor_name?: string;\n  hospital_name?: string;\n  date?: string;\n  diagnosis?: string;\n  medications?: Array<{\n    name: string;\n    dosage?: string;\n    frequency?: string;\n    duration_days?: number;\n  }>;\n  notes?: string;\n  confidence: number;\n}\n\nexport interface FamilyMember {\n  id: string;\n  manager_id: string;\n  member_id: string;\n  relationship: string;\n  member_profile?: Profile;\n  created_at: string;\n}\n\nexport interface ConsentShare {\n  id: string;\n  patient_id: string;\n  doctor_id?: string;\n  share_code: string;\n  qr_data?: string;\n  status: ConsentStatus;\n  permissions: string[];\n  expires_at: string;\n  record_types?: RecordType[];\n  created_at: string;\n  revoked_at?: string;\n  doctor_profile?: Profile;\n}\n\nexport interface AuditLogEntry {\n  id: string;\n  actor_id: string;\n  patient_id: string;\n  action: AuditAction;\n  record_id?: string;\n  consent_share_id?: string;\n  metadata?: Record<string, unknown>;\n  ip_address?: string;\n  created_at: string;\n  actor_profile?: Profile;\n}\n\nexport interface Vaccination {\n  id: string;\n  patient_id: string;\n  vaccine_name: string;\n  vaccine_name_hi?: string;\n  scheduled_date: string;\n  administered_date?: string;\n  status: VaccinationStatus;\n  dose_number: number;\n  batch_number?: string;\n  administered_by?: strin